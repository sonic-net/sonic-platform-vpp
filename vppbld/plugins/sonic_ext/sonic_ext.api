option version = "1.0.0";
import "vnet/interface_types.api";

/** \brief Enable / disable the "receive-DPO check before ACL" feature on
    an L2 port.  Registers sonic-ext-ip2me-ip4/ip6 on the l2-input-ip4 /
    l2-input-ip6 feature arcs, ahead of the ACL plugin, so ip2me
    (destined-to-this-switch) traffic bypasses any ingress drop ACL that
    would otherwise discard it.
    @param client_index - opaque cookie to identify the sender
    @param context - sender context, to match reply w/ request
    @param sw_if_index - the L2 port to enable/disable the feature on
    @param enable - 1 to enable, 0 to disable
*/
autoreply define sonic_ext_ip2me_enable_disable
{
  u32 client_index;
  u32 context;
  vl_api_interface_index_t sw_if_index;
  bool enable;
};

/** \brief Install / remove a deferred egress-mirror (Everflow MIRROR_EGRESS)
    action.  Refcounted: enable=1 on the first action enables the
    sonic-ext-egress-mirror feature on every interface-output arc; enable=0
    on the last removes it.  The mirror destination itself is carried per
    packet by the ACL dataplane node, not by this message.
    @param client_index - opaque cookie to identify the sender
    @param context - sender context, to match reply w/ request
    @param enable - 1 to install an action, 0 to remove one
*/
autoreply define sonic_ext_egress_mirror_enable_disable
{
  u32 client_index;
  u32 context;
  bool enable;
};

/** \brief Enable / disable the Everflow mirror encap fixup on a mirror GRE
    tunnel.  Registers sonic-ext-mirror-encap-fixup on that interface's
    ethernet-output arc, which stamps the exact outer IPv4 TTL and the GRE
    protocol (ethertype) on the encapped copy after GRE encap.  enable=1
    installs/updates the {gre_protocol, hop_limit} values; enable=0 removes
    the fixup.
    @param client_index - opaque cookie to identify the sender
    @param context - sender context, to match reply w/ request
    @param sw_if_index - the mirror GRE tunnel to enable/disable the fixup on
    @param gre_protocol - GRE ethertype to stamp (e.g. 0x88BE for Everflow)
    @param hop_limit - exact outer IPv4 TTL to stamp (must be non-zero)
    @param enable - 1 to install/update, 0 to remove
*/
autoreply define sonic_ext_mirror_encap_fixup_enable_disable
{
  u32 client_index;
  u32 context;
  vl_api_interface_index_t sw_if_index;
  u16 gre_protocol;
  u8 hop_limit;
  bool enable;
};

/** \brief Ask whether a sonic-ext feature is enabled in startup.conf.

    For the features saivpp wires itself -- ip2me, l2-trap-fixup,
    l2-vlan-filter -- VPP only stores the operator's choice; it has no hook
    of its own to skip.  saivpp calls this before deciding to install the
    ACL hook or the classify sessions, so the decision is never made rather
    than made and then refused.

    An unrecognised name replies disabled: the sonic-ext plugin has no such feature,
    so there is nothing for saivpp to wire.

    @param client_index - opaque cookie to identify the sender
    @param context - sender context, to match reply w/ request
    @param feature - keyword as spelled in the sonic-ext stanza
*/
define sonic_ext_feature_get
{
  u32 client_index;
  u32 context;
  string feature[64];
};

define sonic_ext_feature_get_reply
{
  u32 context;
  i32 retval;
  bool enabled;
};
