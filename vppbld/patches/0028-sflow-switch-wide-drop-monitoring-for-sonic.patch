+    def lcp_vif_index(self, sw_if_index):
+        pairs = self.vapi.vpp.details_iter(self.vapi.lcp_itf_pair_get)
+        for p in pairs:
+            if p.phy_sw_if_index == sw_if_index:
+                return p.vif_index
+        return None
+
+    def dropmon_capture(self):
+        """The NET_DM message as it was handed to sendmsg().
+
+        Reading it back from VPP rather than listening on the NET_DM group
+        keeps the test independent of CAP_NET_ADMIN and of whether the
+        kernel was built with CONFIG_NET_DROP_MONITOR - the CI image is
+        not, so a listener-based test could never run there.
+        """
+        out = self.vapi.cli("show sflow dropmon-capture")
+        self.logger.info(out)
+        for line in out.split("\n"):
+            line = line.strip()
+            if line and all(c in "0123456789abcdef" for c in line):
+                return bytes.fromhex(line)
+        return b""
+
+    def test_dropmon_in_port(self):
+        """NET_DM ingress port reports the linux-cp ifIndex"""
+
+        # Pair an interface we do not otherwise use first, so that the vif
+        # index handed to pg0 cannot coincide with pg0's own VPP index -
+        # which would leave the assertion below unable to tell the linux-cp
+        # ifIndex apart from the hw_if_index fallback.
+        self.vapi.cli("test lcp add phy %s host %s" % (self.pg2.name, self.pg3.name))
+        self.vapi.cli("test lcp add phy %s host %s" % (self.pg0.name, self.pg4.name))
+
+        vif_index = self.lcp_vif_index(self.pg0.sw_if_index)
+        self.assertIsNotNone(vif_index, "no linux-cp pair was created for pg0")
+        self.assertNotEqual(
+            vif_index,
+            self.pg0.sw_if_index,
+            "vif index coincides with the VPP index, so this test could "
+            "not tell the two apart",
+        )
+
+        # pg interfaces are their own hardware interfaces
+        self.vapi.sflow_enable_disable(
+            hw_if_index=self.pg0.sw_if_index, enable_disable=True
+        )
+        self.vapi.sflow_sampling_rate_set(sampling_N=1)
+        self.vapi.sflow_drop_monitoring_set(drop_M=1)
+        self.vapi.cli("sflow dropmon-capture enable")
+
+        # ttl=1, so the packet is discarded instead of forwarded
+        p = (
+            Ether(dst=self.pg0.local_mac, src=self.pg0.remote_mac)
+            / IP(src=self.pg0.remote_ip4, dst=self.pg1.remote_ip4, ttl=1)
+            / UDP(sport=randint(49152, 65535), dport=5678)
+            / Raw(b"\xa5" * 64)
+        )
+        self.pg0.add_stream([p])
+        self.pg_start()
+        # allow the discard to reach the main thread and be encoded
+        self.sleep(1.0)
+
+        msg = self.dropmon_capture()
+        self.assertGreater(
+            len(msg),
+            NLMSG_HDRLEN + GENL_HDRLEN,
+            "no NET_DM message was encoded for the discarded packet",
+        )
+
+        nlmsg_len = struct.unpack_from("I", msg, 0)[0]
+        self.assertEqual(
+            nlmsg_len, len(msg), "nlmsg_len disagrees with the message length"
+        )
+
+        attrs = walk_netlink_attrs(msg[NLMSG_HDRLEN + GENL_HDRLEN :])
+        self.assertIn(NET_DM_ATTR_IN_PORT, attrs, "the message carries no IN_PORT")
+
+        nla_type, in_port = attrs[NET_DM_ATTR_IN_PORT]
+        self.assertTrue(nla_type & NLA_F_NESTED, "IN_PORT is not flagged NLA_F_NESTED")
+
+        # IN_PORT is a container, so a listener walks its payload.  The
+        # encoding this replaced put a bare u32 here, whose leading bytes
+        # present as an absurd nla_len, so the walk found nothing and the
+        # ingress port was reported as zero.
+        inner = walk_netlink_attrs(in_port)
+        self.assertIn(
+            NET_DM_ATTR_PORT_NETDEV_IFINDEX,
+            inner,
+            "the IN_PORT payload is not a walkable attribute",
+        )
+
+        _, if_index = inner[NET_DM_ATTR_PORT_NETDEV_IFINDEX]
+        self.assertEqual(len(if_index), 4, "ifIndex is not four bytes")
+        self.assertEqual(
+            struct.unpack("I", if_index)[0],
+            vif_index,
+            "IN_PORT should report the linux-cp ifIndex, not the VPP index",
+        )
