+    def sflow_drop_enabled(self, name):
+        """Is sflow-drop on the error-drop arc of this interface?"""
+        out = self.vapi.cli("show interface features %s" % name)
+        in_arc = False
+        for line in out.split("\n"):
+            line = line.strip()
+            if line.endswith(":"):
+                in_arc = line == "error-drop:"
+            elif in_arc and line.split()[-1:] == ["sflow-drop"]:
+                return True
+        return False
+
+    def get_sflow_counter(self, counter):
+        for line in self.vapi.cli("sh errors").split("\n")[1:]:
+            results = line.split()
+            if len(results) > 1 and results[1] == "sflow":
+                if re.search(counter, line) is not None:
+                    return int(results[0])
+        return None
