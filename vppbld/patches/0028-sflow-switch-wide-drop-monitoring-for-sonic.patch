+class SFlowDropPolicerTestCase(VppTestCase):
+    """sFlow drop notifications metered by a VPP policer"""
+
+    # A pps policer's burst is in ms of its rate, and nothing floors the
+    # bucket the software policer uses.  xlate.c rounds 1 pps at the fixed
+    # 256-byte packet size to 2 kbps, so 36 s of it is 9000 bytes: 35
+    # notifications.
+    CIR_PPS = 1
+    BURST_MS = 36000
+    BURST_PKTS = 35
+
+    def setUp(self):
+        super(SFlowDropPolicerTestCase, self).setUp()
+        # the tests share one VPP, and "sh errors" counters are cumulative
+        self.vapi.cli("clear errors")
+        self.create_pg_interfaces(range(2))
+        for i in self.pg_interfaces:
+            i.admin_up()
+            i.config_ip4()
+            i.resolve_arp()
+
+    def tearDown(self):
+        self.vapi.sflow_drop_policer_set(name="")
+        self.vapi.sflow_drop_monitoring_set(drop_M=0)
+        for i in self.pg_interfaces:
+            i.admin_down()
+            i.unconfig()
+        super(SFlowDropPolicerTestCase, self).tearDown()
+
+    def get_sflow_counter(self, counter):
+        for line in self.vapi.cli("sh errors").split("\n")[1:]:
+            results = line.split()
+            if len(results) > 1 and results[1] == "sflow":
+                if re.search(counter, line) is not None:
+                    return int(results[0])
+        return 0
+
+    def drained(self):
+        """Drop notifications the main thread has dequeued, whether sent,
+        failed to send (there is no NET_DM family without
+        CONFIG_NET_DROP_MONITOR) or rate-limited."""
+        return sum(
+            int(n)
+            for n in re.findall(
+                r"drop samples (?:sent|dropped|rate-limited): (\d+)",
+                self.vapi.cli("show sflow"),
+            )
+        )
+
+    def send_discards(self, count):
+        """One discard at a time, each waited for until the main thread has
+        dequeued it: the worker drop FIFO holds only 3, and how often the main
+        thread drains it is not something to race."""
+        for _ in range(count):
+            target = self.drained() + 1
+            p = (
+                Ether(dst=self.pg0.local_mac, src=self.pg0.remote_mac)
+                / IP(src=self.pg0.remote_ip4, dst=self.pg1.remote_ip4, ttl=1)
+                / UDP(sport=randint(49152, 65535), dport=5678)
+                / Raw(b"\xa5" * 64)
+            )
+            self.pg0.add_stream([p])
+            self.pg_start()
+            deadline = time.monotonic() + 5
+            while self.drained() < target:
+                self.assertLess(
+                    time.monotonic(), deadline, "a discard was never dequeued"
+                )
+                self.sleep(0.01)
+
+    def dequeued(self):
+        return self.get_sflow_counter(
+            "sflow discards processed"
+        ) - self.get_sflow_counter("sflow discards dropped")
+
+    def rate_limited(self):
+        return self.vapi.sflow_drop_policer_get().rate_limited
+
+    def test_drop_policer(self):
+        """drop notifications the policer drops are suppressed and counted"""
+
+        ret = self.vapi.sflow_drop_policer_get()
+        self.assertEqual(ret.name, "", "a drop policer is bound by default")
+
+        # bound by name before the policer exists: unlimited until it does
+        self.vapi.sflow_drop_policer_set(name="sflow-drop")
+        self.assertEqual(self.vapi.sflow_drop_policer_get().name, "sflow-drop")
+        self.vapi.sflow_drop_monitoring_set(drop_M=1)
+        self.send_discards(3)
+        self.assertEqual(self.rate_limited(), 0, "limited by a missing policer")
+
+        self.vapi.cli("sflow drop-monitoring policer none")
+        self.assertEqual(self.vapi.sflow_drop_policer_get().name, "")
+        self.vapi.cli("sflow drop-monitoring policer sflow-drop")
+        self.assertIn("policer sflow-drop (unresolved)", self.vapi.cli("show sflow"))
+
+        # 1R2C pps policer: conform transmits, exceed/violate drop
+        policer = VppPolicer(
+            self, "sflow-drop", self.CIR_PPS, 0, self.BURST_MS, 0, rate_type=1
+        ).add_vpp_config()
+        self.assertIn("policer sflow-drop\n", self.vapi.cli("show sflow") + "\n")
+
+        before = self.dequeued()
+        count = self.BURST_PKTS + 24
+        t0 = time.monotonic()
+        self.send_discards(count)
+        elapsed = time.monotonic() - t0
+
+        dequeued = self.dequeued() - before
+        limited = self.rate_limited()
+        stats = policer.get_stats()
+        self.logger.info(
+            "dequeued=%d rate_limited=%d elapsed=%.3f stats=%s"
+            % (dequeued, limited, elapsed, stats)
+        )
+        self.assertGreater(limited, 0, "the policer dropped nothing")
+        self.assertEqual(
+            limited,
+            self.get_sflow_counter("sflow DROPMON rate-limited"),
+            "API and node counter disagree",
+        )
+        passed = dequeued - limited
+        self.assertGreaterEqual(passed, self.BURST_PKTS)
+        self.assertLessEqual(
+            passed,
+            self.BURST_PKTS + int(self.CIR_PPS * elapsed) + 1,
+            "more drop notifications than burst + rate * elapsed",
+        )
+
+        # the notifications show up in the policer's own stats, metered in
+        # packets at the pps fixed packet size
+        self.assertEqual(stats["conform_packets"], passed)
+        self.assertEqual(stats["conform_bytes"], passed * 256)
+        self.assertEqual(stats["exceed_packets"] + stats["violate_packets"], limited)
+
+        # unbinding stops the metering, the policer itself is untouched
+        self.vapi.sflow_drop_policer_set(name="")
+        self.send_discards(5)
+        self.assertEqual(
+            self.rate_limited(),
+            limited,
+            "notifications were rate-limited with no policer bound",
+        )
+        self.assertEqual(policer.get_stats(), stats)
+
+        # deleting a bound policer also leaves the notifications unlimited
+        self.vapi.sflow_drop_policer_set(name="sflow-drop")
+        policer.remove_vpp_config()
+        self.send_discards(5)
+        self.assertEqual(self.rate_limited(), limited)
+
+    def test_drop_policer_bucket_below_one_notification(self):
+        """a bucket smaller than one notification drops every notification"""
+
+        # 1000 ms at 1 pps is a 250-byte bucket.  vnet_police_packet() would
+        # scale a 256-byte notification against it to 2^32, wrapping to 0,
+        # and let every one through.
+        policer = VppPolicer(
+            self, "sflow-drop", self.CIR_PPS, 0, 1000, 0, rate_type=1
+        ).add_vpp_config()
+        self.vapi.sflow_drop_policer_set(name="sflow-drop")
+        self.vapi.sflow_drop_monitoring_set(drop_M=1)
+
+        before = self.dequeued()
+        limited_before = self.rate_limited()
+        self.send_discards(5)
+        dequeued = self.dequeued() - before
+
+        self.assertEqual(dequeued, 5)
+        self.assertEqual(self.rate_limited() - limited_before, dequeued)
+        stats = policer.get_stats()
+        self.assertEqual(stats["conform_packets"], 0)
+        self.assertEqual(stats["violate_packets"], dequeued)
