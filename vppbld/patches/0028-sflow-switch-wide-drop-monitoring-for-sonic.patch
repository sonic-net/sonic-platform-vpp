+def walk_netlink_attrs(payload):
+    """Walk a netlink attribute list the way a NET_DM listener does.
+
+    Returns {type-without-flags: (type-with-flags, value)}.  An attribute
+    whose nla_len does not fit stops the walk, exactly as the kernel's
+    nla_ok() would.
+    """
+    attrs = {}
+    offset = 0
+    while offset + 4 <= len(payload):
+        nla_len, nla_type = struct.unpack_from("HH", payload, offset)
+        if nla_len < 4 or offset + nla_len > len(payload):
+            break
+        attrs[nla_type & ~NLA_F_NESTED] = (
+            nla_type,
+            payload[offset + 4 : offset + nla_len],
+        )
+        offset += (nla_len + 3) & ~3
+    return attrs
+
 
