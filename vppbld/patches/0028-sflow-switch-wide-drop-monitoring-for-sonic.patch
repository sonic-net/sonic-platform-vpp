+class SFlowDropAllInterfacesTestCase(VppTestCase):
+    """sFlow drop monitoring is switch-wide"""
+
+    def setUp(self):
+        super(SFlowDropAllInterfacesTestCase, self).setUp()
+        self.create_pg_interfaces(range(2))
+        for i in self.pg_interfaces:
+            i.admin_up()
+            i.config_ip4()
+            i.resolve_arp()
+        self.sampled = set()
+
+    def tearDown(self):
+        self.vapi.sflow_drop_monitoring_set(drop_M=0)
+        for i in self.pg_interfaces:
+            if i in self.sampled:
+                self.set_sampling(i, False)
+            i.admin_down()
+            i.unconfig()
+        super(SFlowDropAllInterfacesTestCase, self).tearDown()
+
+    def set_sampling(self, intf, enable):
+        """sflow_enable_disable() rejects a no-op toggle, so track which
+        interfaces are sampled for tearDown."""
+        # pg interfaces are their own hardware interfaces
+        self.vapi.sflow_enable_disable(
+            hw_if_index=intf.sw_if_index, enable_disable=enable
+        )
+        if enable:
+            self.sampled.add(intf)
+        else:
+            self.sampled.discard(intf)
+
+    def sflow_drop_count(self, name):
+        """How many times is sflow-drop on the error-drop arc of this
+        interface?"""
+        out = self.vapi.cli("show interface features %s" % name)
+        in_arc = False
+        count = 0
+        for line in out.split("\n"):
+            line = line.strip()
+            if line.endswith(":"):
+                in_arc = line == "error-drop:"
+            elif in_arc and line.split()[-1:] == ["sflow-drop"]:
+                count += 1
+        return count
+
+    def sflow_drop_enabled(self, name):
+        """Is sflow-drop on the error-drop arc of this interface?"""
+        return self.sflow_drop_count(name) > 0
+
+    def send_discard(self):
+        # ttl=1, so the packet is discarded instead of forwarded
+        p = (
+            Ether(dst=self.pg0.local_mac, src=self.pg0.remote_mac)
+            / IP(src=self.pg0.remote_ip4, dst=self.pg1.remote_ip4, ttl=1)
+            / UDP(sport=randint(49152, 65535), dport=5678)
+            / Raw(b"\xa5" * 64)
+        )
+        self.pg0.add_stream([p])
+        self.pg_start()
+        # allow the discard to reach the main thread
+        self.sleep(1.0)
+
+    def get_sflow_counter(self, counter):
+        for line in self.vapi.cli("sh errors").split("\n")[1:]:
+            results = line.split()
+            if len(results) > 1 and results[1] == "sflow":
+                if re.search(counter, line) is not None:
+                    return int(results[0])
+        return None
+
+    def test_drop_monitoring_all_interfaces(self):
+        """discards are reported from ports sampling is not enabled on"""
+
+        # sampling is deliberately left disabled on every interface
+        self.vapi.sflow_drop_monitoring_set(drop_M=1)
+        for i in self.pg_interfaces:
+            self.assertTrue(
+                self.sflow_drop_enabled(i.name),
+                "sflow-drop is not on %s's error-drop arc" % i.name,
+            )
+
+        # an interface created afterwards is covered too
+        lo = VppLoInterface(self)
+        self.assertTrue(
+            self.sflow_drop_enabled(lo.name),
+            "sflow-drop is not on the error-drop arc of a new interface",
+        )
+        lo.remove_vpp_config()
+
+        self.send_discard()
+        self.assert_equal(
+            self.get_sflow_counter("sflow discards processed"),
+            1,
+            "sflow discards processed",
+        )
+        # no sampling is enabled, so no packet samples were taken
+        self.assert_equal(
+            self.get_sflow_counter("sflow packets processed"),
+            None,
+            "sflow packets processed",
+        )
+
+        self.vapi.sflow_drop_monitoring_set(drop_M=0)
+        for i in self.pg_interfaces:
+            self.assertFalse(
+                self.sflow_drop_enabled(i.name),
+                "sflow-drop is still on %s's error-drop arc" % i.name,
+            )
+
+    def test_sampling_off_leaves_drop_monitoring(self):
+        """per-port sampling changes neither add nor strand sflow-drop"""
+
+        for i in self.pg_interfaces:
+            self.set_sampling(i, True)
+        self.vapi.sflow_sampling_rate_set(sampling_N=1)
+        self.vapi.sflow_drop_monitoring_set(drop_M=1)
+        for i in self.pg_interfaces:
+            self.assert_equal(self.sflow_drop_count(i.name), 1, i.name)
+
+        # Upstream re-enabled sflow-drop here (passing dropM rather than the
+        # desired state), so it was on pg0's arc twice ...
+        self.set_sampling(self.pg0, False)
+        self.assert_equal(
+            self.sflow_drop_count(self.pg0.name),
+            1,
+            "sflow-drop on pg0 after disabling its sampling",
+        )
+
+        # ... and turning drop monitoring off only visited sampled ports, so
+        # pg0 kept reporting discards while pg1 kept the process running.
+        self.vapi.sflow_drop_monitoring_set(drop_M=0)
+        for i in self.pg_interfaces:
+            self.assert_equal(self.sflow_drop_count(i.name), 0, i.name)
+
+        processed = self.get_sflow_counter("sflow discards processed")
+        self.send_discard()
+        self.assert_equal(
+            self.get_sflow_counter("sflow discards processed"),
+            processed,
+            "discard on pg0 reported with drop monitoring off",
+        )
+
