   u8 tcp_flags_value;
+/*
+ * Match only packets received on this ingress interface.
+ * 0 => match any interface. sw_if_index 0 is local0, which is never a
+ * data-plane port, so it is used as the "any" value rather than spending
+ * a separate valid flag - the same convention proto = 0 uses for L4.
+ *
+ * Only the low 16 bits are matched, so an index that does not fit in 16
+ * bits is rejected rather than matched as a different interface.
+ */
+  u32 in_sw_if_index;
 };
 
 
