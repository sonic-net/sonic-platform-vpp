diff --git a/test/test_linux_cp.py b/test/test_linux_cp.py
--- a/test/test_linux_cp.py
+++ b/test/test_linux_cp.py
@@ -3,3 +3,6 @@
 import unittest
 import socket
+import subprocess
+import tempfile
+from contextlib import ExitStack, contextmanager
 from ipaddress import ip_address, ip_interface
@@ -1470,3 +1473,69 @@ class TestLinuxCPPairManagement(TestLinuxCPNetNSBase):
+    @contextmanager
+    def _tap_pair(self, name, mtu, *, parent_up=False):
+        with ExitStack() as cleanup:
+            (parent,) = self.create_loopback_interfaces(1)
+            cleanup.callback(parent.remove_vpp_config)
+            parent.set_l3_mtu(mtu)
+            if parent_up:
+                parent.admin_up()
+            self.vapi.cli(
+                f"lcp create {parent.name} host-if {name} netns {self.ns_name}"
+            )
+            cleanup.callback(self.vapi.cli, f"lcp delete {parent.name}")
+            yield get_interface_info(self.ns_name, name)
+
+    def _check_down_tap_publication(self, name):
+        mtu = 9000
+        with ExitStack() as cleanup:
+            trace = cleanup.enter_context(tempfile.NamedTemporaryFile(dir=self.tempdir))
+            netns = ["ip", "netns", "exec", self.ns_name]
+            monitor = cleanup.enter_context(
+                subprocess.Popen(netns + ["rtmon", "file", trace.name, "link"])
+            )
+            cleanup.callback(monitor.terminate)
+
+            def events():
+                self.assertIsNone(monitor.poll(), "rtmon exited during capture")
+                return subprocess.check_output(
+                    ["ip", "-o", "monitor", "link", "file", trace.name], text=True
+                )
+
+            # rtmon subscribes before dumping existing links. Seeing lo means
+            # even the very first notification from pair creation will be recorded.
+            self.poll_for("rtmon initial dump", lambda: ": lo: <" in events(), True)
+            with self._tap_pair(name, mtu) as link:
+                prefix = f"{link['ifindex']}: {name}: "
+                self.assertEqual(link["mtu"], mtu)
+                self.assertNotIn("UP", link["flags"])
+
+            # Deletion delimits the capture for this ifindex; a final-state
+            # query alone misses publication at the default MTU or a transient UP.
+            self.poll_for(
+                "rtmon saw TAP deletion", lambda: f"Deleted {prefix}" in events(), True
+            )
+            published = [
+                line for line in events().splitlines() if line.startswith(prefix)
+            ]
+            self.assertTrue(published, f"no link notification for {name}")
+            for event in published:
+                self.assertIn(f" mtu {mtu} ", event)
+                self.assertNotRegex(event, r"<[^>]*\bUP\b")
+
+    def test_tap_publication_down(self):
+        """The front-panel name is first visible down and at its configured MTU."""
+        self._check_down_tap_publication("Ethernet0")
+
+    def test_tap_publication_down_tap0(self):
+        """The requested name can itself be the kernel's first free TAP name."""
+        self._check_down_tap_publication("tap0")
+
+    def test_tap_publication_up(self):
+        """An initially up parent's host TAP is still brought up."""
+        mtu = 9000
+        with self._tap_pair("hup0", mtu, parent_up=True) as link:
+            self.assertIn("UP", link["flags"])
+            self.assertEqual(link["mtu"], mtu)
+
     def test_pair_create_delete_tun(self):
         """Create and delete TUN LCP pair on loopback"""
         self.create_loopback_interfaces(1)
