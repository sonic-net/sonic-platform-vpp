+    def hash_hits(self, acl, rule):
+        # Only the hash matcher increments this applied-entry hitcount. The
+        # normal ACL rule counter below increments on either lookup path.
+        dump = self.cli("show acl-plugin tables applied")
+        matches = re.findall(
+            rf"\bacl\s+{acl}\s+rule\s+{rule}\b[^\n]*\bhitcount\s+(\d+)", dump
+        )
+        self.assertTrue(matches, (acl, rule, dump))
+        return sum(map(int, matches))
+
+    def check_lookup(self, acl, rule, packet, hashed, expect=1):
+        before_hash = self.hash_hits(acl, rule)
+        before_rule = self.counter(acl, rule)
+        captured = self.transmit(packet, expect=expect)
+        self.assertEqual(self.counter(acl, rule) - before_rule, 1)
+        self.assertEqual(self.hash_hits(acl, rule) - before_hash, int(hashed))
+        return captured
+
+    def test_context_qualifiers_replace_and_rebind(self):
+        """Add/remove VLAN and IN_PORTS requirements on an existing context."""
+        child = self.child(self.pgs[0])
+        self.bridge([child, self.pgs[1]])
+        for ipv6 in (False, True):
+            packet = self.packet(ipv6, tags=(100, 10))
+            deny = self.rule(action=0, ipv6=ipv6)
+            acl = self.acl([self.rule(ipv6=ipv6), deny])
+            self.bind(child, acl)
+            # No qualifiers: a bridged child must retain the ordinary hash path.
+            self.check_lookup(acl, 0, packet, hashed=True)
+            # IN_PORTS alone still needs both parent and exact-child identity;
+            # no VLAN rule is present to cause metadata extraction incidentally.
+            for in_port, rule, expect in ((self.pgs[0], 0, 1),
+                                          (child, 0, 1),
+                                          (self.pgs[2], 1, 0)):
+                self.acl([self.rule(ipv6=ipv6, in_port=in_port), deny], index=acl)
+                self.check_lookup(acl, rule, packet, hashed=False, expect=expect)
+            # Replace IN_PORTS with VLAN-only: the VLAN must be filled, while
+            # removing IN_PORTS restores hash lookup even on a bridged child.
+            self.acl([self.rule(100, 0xfff, ipv6=ipv6), deny], index=acl)
+            captured = self.check_lookup(acl, 0, packet, hashed=True)
+            self.assertEqual(captured[0][Dot1Q].vlan, 10)
+            self.acl([self.rule(100, 0xfff, ipv6=ipv6,
+                                in_port=self.pgs[0]), deny], index=acl)
+            self.check_lookup(acl, 0, packet, hashed=False)
+            # A zero mask removes VLAN sensitivity; removing the last scoped
+            # rule clears the IN_PORTS flag and restores the ordinary hash path.
+            self.acl([self.rule(200, 0, ipv6=ipv6), deny], index=acl)
+            self.check_lookup(acl, 0, packet, hashed=True)
+            # Rebinding changes the context's ACL vector without replacing any
+            # rules. This must refresh both flags too, including context reuse.
+            scoped = self.acl([self.rule(ipv6=ipv6, in_port=self.pgs[0]), deny])
+            self.bind(child, scoped)
+            self.check_lookup(scoped, 0, packet, hashed=False)
+            self.bind(child, acl)
+            self.check_lookup(acl, 0, packet, hashed=True)
+            self.rpc("acl_interface_set_acl_list", sw_if_index=child,
+                     n_input=0, count=0, acls=[])
+            self.bind(child, acl)
+            self.check_lookup(acl, 0, packet, hashed=True)
+
+    def test_egress_child_keeps_hash_and_exact_interface_scope(self):
+        """Egress VLAN lookup stays hashed and never inherits ingress scope."""
+        ingress = self.child(self.pgs[0])
+        egress = self.child(self.pgs[1])
+        self.bridge([ingress, egress])
+        for ipv6 in (False, True):
+            packet = self.packet(ipv6, tags=(100, 10))
+            deny = self.rule(action=0, ipv6=ipv6)
+            acl = self.acl([self.rule(100, 0xfff, ipv6=ipv6), deny])
+            self.bind(egress, acl, ingress=False)
+            captured = self.check_lookup(acl, 0, packet, hashed=True)
+            self.assertEqual(captured[0][Dot1Q].vlan, 100)
+            self.assertEqual(captured[0][Dot1Q:2].vlan, 10)
+            # Exercise the raw VPP interface predicate: an egress child does
+            # not gain its parent's identity, even when the context has IN_PORTS.
+            self.acl([self.rule(ipv6=ipv6, in_port=self.pgs[1]), deny], index=acl)
+            self.check_lookup(acl, 1, packet, hashed=True, expect=0)
+            self.acl([self.rule(ipv6=ipv6, in_port=egress), deny], index=acl)
+            self.check_lookup(acl, 0, packet, hashed=True)
+
