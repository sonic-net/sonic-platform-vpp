+#!/usr/bin/env python3
+"""Focused live ACL regressions, runnable without the full VPP test venv.
+
+Run with the built VPP libraries on LD_LIBRARY_PATH and the VPP Python API
+and Scapy on PYTHONPATH. VPP_BINARY, VPP_PLUGIN_PATH and VPP_API_DIR may
+override the native build locations. All VPP state and packet captures are
+isolated in a temporary directory; no physical/network interfaces are used.
+"""
+
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import time
+import unittest
+
+from scapy.layers.inet import IP, UDP
+from scapy.layers.inet6 import IPv6, IPv6ExtHdrFragment
+from scapy.layers.l2 import Dot1Q, Dot1AD, Ether
+from scapy.packet import Raw
+from scapy.utils import rdpcap, wrpcap
+from vpp_papi import VPPApiClient
+from vpp_papi.vpp_stats import VPPStats
+
+
+ROOT = Path(__file__).resolve().parents[1]
+BUILD = ROOT / "build-root/build-vpp-native/vpp"
+
+
+class TestAclOuterVlan(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(prefix="acl-outer-vlan-")
+        self.path = Path(self.temp.name)
+        self.sequence = 0
+        self.pgs = []
+        self.bridge_domains = set()
+        plugins = os.environ.get(
+            "VPP_PLUGIN_PATH", str(BUILD / "lib/x86_64-linux-gnu/vpp_plugins")
+        )
+        config = self.path / "startup.conf"
+        config.write_text(
+            f"unix {{ nodaemon runtime-dir {self.path} log {self.path}/vpp.log "
+            f"cli-listen {self.path}/cli.sock }}\n"
+            f"socksvr {{ socket-name {self.path}/api.sock }}\n"
+            f"statseg {{ socket-name {self.path}/stats.sock size 32m }}\n"
+            f"api-segment {{ prefix acl-vlan-{os.getpid()} }}\n"
+            "memory { main-heap-size 256m }\n"
+            f"cpu {{ main-core {min(os.sched_getaffinity(0))} }}\n"
+            f"plugins {{ path {plugins} plugin default {{ disable }} "
+            "plugin acl_plugin.so { enable } }\n"
+        )
+        self.log = (self.path / "console.log").open("w")
+        self.proc = subprocess.Popen(
+            [os.environ.get("VPP_BINARY", str(BUILD / "bin/vpp")), "-c", str(config)],
+            stdout=self.log,
+            stderr=subprocess.STDOUT,
+        )
+        self.addCleanup(self.stop_vpp)
+        for _ in range(100):
+            if (self.path / "api.sock").exists():
+                break
+            if self.proc.poll() is not None:
+                self.log.flush()
+                self.fail((self.path / "console.log").read_text())
+            time.sleep(0.02)
+        api_dir = Path(os.environ.get("VPP_API_DIR", str(BUILD / "CMakeFiles")))
+        # Other plugins may have stale imported ACL type definitions after
+        # an incremental plugin-only build. Only core and ACL APIs are used.
+        api_files = [str(path) for path in api_dir.rglob("*.api.json")
+                     if "plugins" not in path.parts or path.parent.name == "acl"]
+        self.client = VPPApiClient(
+            apifiles=api_files,
+            server_address=str(self.path / "api.sock"),
+        )
+        self.client.connect("acl-vlan-regression")
+        self.api = self.client.api
+        self.stats = VPPStats(socketname=str(self.path / "stats.sock"))
+        self.stats.connect()
+        self.rpc("acl_stats_intf_counters_enable", enable=1)
+        for i in range(3):
+            pg = self.rpc("pg_create_interface", interface_id=i).sw_if_index
+            self.rpc("sw_interface_set_flags", sw_if_index=pg, flags=1)
+            self.rpc(
+                "sw_interface_set_mac_address",
+                sw_if_index=pg,
+                mac_address=f"02:00:00:00:00:{i + 1:02x}",
+            )
+            self.pgs.append(pg)
+
+    def stop_vpp(self):
+        if hasattr(self, "stats"):
+            self.stats.disconnect()
+        if hasattr(self, "client"):
+            self.client.disconnect()
+        self.proc.terminate()
+        try:
+            self.proc.wait(timeout=5)
+        except subprocess.TimeoutExpired:
+            self.proc.kill()
+            self.proc.wait(timeout=5)
+        self.log.close()
+        self.temp.cleanup()
+
+    def rpc(self, name, **kwargs):
+        try:
+            reply = getattr(self.api, name)(**kwargs)
+        except Exception as error:
+            self.log.flush()
+            raise AssertionError(f"{name}: {error}\n" +
+                                 (self.path / "console.log").read_text()) from error
+        self.assertEqual(reply.retval, 0, (name, kwargs, reply))
+        return reply
+
+    def cli(self, command):
+        return self.rpc("cli_inband", cmd=command).reply
+
+    def bridge(self, interfaces, vlan=100):
+        if vlan not in self.bridge_domains:
+            self.rpc("bridge_domain_add_del_v2", bd_id=vlan, is_add=1,
+                     flood=1, uu_flood=1, learn=0, forward=1)
+            self.bridge_domains.add(vlan)
+        for interface in interfaces:
+            self.rpc("sw_interface_set_l2_bridge", rx_sw_if_index=interface,
+                     bd_id=vlan, enable=1)
+
+    def child(self, parent, vlan=100, dot1ad=False):
+        # A single outer tag classification without exact-match also accepts
+        # QinQ. POP_1 must leave the inner customer tag intact.
+        child = self.rpc("create_subif", sw_if_index=parent, sub_id=vlan,
+                         outer_vlan_id=vlan, sub_if_flags=2 | (8 if dot1ad else 0))
+        self.rpc("sw_interface_set_flags", sw_if_index=child.sw_if_index, flags=1)
+        self.rpc("l2_interface_vlan_tag_rewrite", sw_if_index=child.sw_if_index,
+                 vtr_op=3, push_dot1q=not dot1ad)
+        return child.sw_if_index
+
+    def rule(self, vlan=0, mask=0, action=1, ipv6=False, in_port=0):
+        return dict(is_permit=action, src_prefix="::/0" if ipv6 else "0.0.0.0/0",
+                    dst_prefix="::/0" if ipv6 else "0.0.0.0/0", proto=0,
+                    srcport_or_icmptype_last=65535, dstport_or_icmpcode_last=65535,
+                    outer_vlan_id=vlan, outer_vlan_id_mask=mask,
+                    in_sw_if_index=in_port)
+
+    def acl(self, rules, index=0xffffffff):
+        return self.rpc("acl_add_replace", acl_index=index, count=len(rules),
+                        r=rules, tag="outer-vlan-regression").acl_index
+
+    def bind(self, interface, acl, ingress=True):
+        self.rpc("acl_interface_set_acl_list", sw_if_index=interface,
+                 n_input=int(ingress), count=1, acls=[acl])
+
+    def packet(self, ipv6=False, tags=(), dot1ad=False, fragment=False,
+               routed=False):
+        packet = Ether(src="02:00:00:00:10:01",
+                       dst="02:00:00:00:00:01" if routed else "02:00:00:00:10:02")
+        for i, vlan in enumerate(tags):
+            packet /= Dot1AD(vlan=vlan) if dot1ad and i == 0 else Dot1Q(vlan=vlan)
+        packet /= (IPv6(src="2001:db8:1::2", dst="2001:db8:2::2") if ipv6
+                   else IP(src="192.0.2.2", dst="198.51.100.2"))
+        if fragment:
+            if ipv6:
+                packet /= IPv6ExtHdrFragment(nh=17, offset=1, id=1)
+            else:
+                packet[IP].frag = 1
+                packet[IP].proto = 17
+            packet /= Raw(b"fragment payload" * 4)
+        else:
+            packet /= UDP(sport=12345, dport=23456) / Raw(b"ACL VLAN regression" * 3)
+        return packet
+
+    def transmit(self, packet, expect=1, dst_pg=1):
+        self.sequence += 1
+        source = self.path / f"input{self.sequence}.pcap"
+        target = self.path / f"output{self.sequence}.pcap"
+        wrpcap(str(source), [packet])
+        self.cli(f"packet-generator capture pg{dst_pg} pcap {target}")
+        self.cli(f"packet-generator new pcap {source} source pg0 name stream{self.sequence}")
+        self.cli(f"packet-generator enable-stream stream{self.sequence}")
+        for _ in range(100):
+            if "Yes" not in self.cli("show packet-generator"):
+                break
+            time.sleep(0.01)
+        self.cli(f"packet-generator capture pg{dst_pg} pcap {target} disable")
+        packets = rdpcap(str(target)) if target.exists() and target.stat().st_size > 24 else []
+        self.assertEqual(len(packets), expect,
+                         (self.cli("show errors"), self.cli("show trace")))
+        return packets
+
+    def counter(self, acl, rule):
+        return self.stats[f"/acl/{acl}/matches"][:, rule].sum_packets()
+
+    def test_hash_collisions_masks_wildcard_and_fragments(self):
+        self.bridge(self.pgs[:2])
+        for ipv6 in (False, True):
+            rules = [self.rule(200, 0xfff, ipv6=ipv6),
+                     self.rule(100, 0xfff, action=0, ipv6=ipv6),
+                     self.rule(ipv6=ipv6)]
+            acl = self.acl(rules)
+            self.bind(self.pgs[0], acl)
+            for hashed in (1, 0):
+                self.cli(f"set acl-plugin use-hash-acl-matching {hashed}")
+                self.transmit(self.packet(ipv6), expect=0)
+                # Nonfirst fragments take the linear fallback in hash mode.
+                self.transmit(self.packet(ipv6, fragment=True), expect=0)
+            self.assertEqual(self.counter(acl, 1), 4)
+            # All IP/L4 fields remain identical, only membership/PVID changes.
+            self.bridge(self.pgs[:2], vlan=200)
+            self.cli("set acl-plugin use-hash-acl-matching 1")
+            self.transmit(self.packet(ipv6))
+            self.assertEqual(self.counter(acl, 0), 1)
+            self.bridge(self.pgs[:2], vlan=300)
+            self.transmit(self.packet(ipv6))
+            self.assertEqual(self.counter(acl, 2), 1)
+            # Partial masks retain only the specified VID bits.
+            acl = self.acl([self.rule(0x120, 0xff0, ipv6=ipv6),
+                            self.rule(action=0, ipv6=ipv6)], index=acl)
+            self.bridge(self.pgs[:2], vlan=0x12f)
+            self.transmit(self.packet(ipv6))
+            self.bridge(self.pgs[:2], vlan=0x130)
+            self.transmit(self.packet(ipv6), expect=0)
+            self.assertEqual(self.counter(acl, 0), 1)
+            self.assertEqual(self.counter(acl, 1), 1)
+            self.bridge(self.pgs[:2])
+
+    def test_qinq_ingress_parent_and_exact_child_scope(self):
+        child = self.child(self.pgs[0])
+        self.bridge([child, self.pgs[1]])
+        for ipv6 in (False, True):
+            for in_port in (self.pgs[0], child):
+                acl = self.acl([self.rule(100, 0xfff, ipv6=ipv6, in_port=in_port),
+                                self.rule(action=0, ipv6=ipv6)])
+                self.bind(child, acl)
+                captured = self.transmit(self.packet(ipv6, tags=(100, 10)))
+                self.assertEqual(captured[0][Dot1Q].vlan, 10)
+                self.assertEqual(self.counter(acl, 0), 1)
+        # A different physical parent must still fail its scoped rule.
+        acl = self.acl([self.rule(100, 0xfff, in_port=self.pgs[2]),
+                        self.rule(action=0)])
+        self.bind(child, acl)
+        self.transmit(self.packet(tags=(100, 10)), expect=0)
+        self.assertEqual(self.counter(acl, 1), 1)
+
+    def test_qinq_egress_untagged_pvid_and_tagged_member(self):
+        ingress = self.child(self.pgs[0])
+        self.bridge([ingress, self.pgs[1]])
+        for ipv6 in (False, True):
+            acl = self.acl([self.rule(10, 0xfff, action=0, ipv6=ipv6),
+                            self.rule(100, 0xfff, ipv6=ipv6),
+                            self.rule(action=0, ipv6=ipv6)])
+            self.bind(self.pgs[1], acl, ingress=False)
+            captured = self.transmit(self.packet(ipv6, tags=(100, 10)))
+            self.assertEqual(captured[0][Dot1Q].vlan, 10)
+            self.assertEqual(self.counter(acl, 1), 1)
+        # Output POP_1 is reversed to PUSH_1. The VLAN to be put on the
+        # wire, rather than the surviving inner tag, must select the rule.
+        self.rpc("sw_interface_set_l2_bridge", rx_sw_if_index=self.pgs[1],
+                 bd_id=100, enable=0)
+        egress = self.child(self.pgs[1], vlan=200, dot1ad=True)
+        self.bridge([ingress, egress])
+        for ipv6 in (False, True):
+            acl = self.acl([self.rule(100, 0xfff, action=0, ipv6=ipv6),
+                            self.rule(200, 0xfff, ipv6=ipv6),
+                            self.rule(action=0, ipv6=ipv6)])
+            self.bind(egress, acl, ingress=False)
+            captured = self.transmit(self.packet(ipv6, tags=(100, 10)))
+            self.assertEqual(captured[0][Dot1AD].vlan, 200)
+            self.assertEqual(captured[0][Dot1Q].vlan, 10)
+            self.assertEqual(self.counter(acl, 1), 1)
+
+    def test_routed_subinterface_vlan_metadata(self):
+        ingress = self.rpc("create_vlan_subif", sw_if_index=self.pgs[0],
+                           vlan_id=100).sw_if_index
+        egress = self.rpc("create_vlan_subif", sw_if_index=self.pgs[1],
+                          vlan_id=200).sw_if_index
+        for interface in (ingress, egress):
+            self.rpc("sw_interface_set_flags", sw_if_index=interface, flags=1)
+        for ipv6 in (False, True):
+            for interface, prefix in ((ingress, "2001:db8:1::1/64" if ipv6 else "192.0.2.1/24"),
+                                      (egress, "2001:db8:2::1/64" if ipv6 else "198.51.100.1/24")):
+                self.rpc("sw_interface_add_del_address", sw_if_index=interface,
+                         is_add=1, prefix=prefix)
+            self.rpc("ip_neighbor_add_del", is_add=1,
+                     neighbor=dict(sw_if_index=egress,
+                                   ip_address="2001:db8:2::2" if ipv6 else "198.51.100.2",
+                                   mac_address="02:00:00:00:10:02"))
+            acl_in = self.acl([self.rule(100, 0xfff, ipv6=ipv6),
+                               self.rule(action=0, ipv6=ipv6)])
+            acl_out = self.acl([self.rule(200, 0xfff, ipv6=ipv6),
+                                self.rule(action=0, ipv6=ipv6)])
+            self.bind(ingress, acl_in)
+            self.bind(egress, acl_out, ingress=False)
+            captured = self.transmit(self.packet(ipv6, tags=(100,), routed=True))
+            self.assertEqual(captured[0][Dot1Q].vlan, 200)
+            self.assertEqual(self.counter(acl_in, 0), 1)
+            self.assertEqual(self.counter(acl_out, 0), 1)
+
+    def test_api_dump_and_reflect_conflicts_are_atomic(self):
+        reply = self.api.acl_add_replace(acl_index=0xffffffff, count=1,
+                                         r=[self.rule(100, 0xfff, action=2)])
+        self.assertLess(reply.retval, 0)
+        vlan = self.acl([self.rule(100, 0xfff)])
+        reflect = self.acl([self.rule(action=2)])
+        self.bind(self.pgs[0], reflect)
+        reply = self.api.acl_interface_set_acl_list(sw_if_index=self.pgs[0],
+                                                    n_input=2, count=2,
+                                                    acls=[reflect, vlan])
+        self.assertLess(reply.retval, 0)
+        binding = self.api.acl_interface_list_dump(sw_if_index=self.pgs[0])[0]
+        self.assertEqual(list(binding.acls), [reflect])
+        # Replacing a bound ACL cannot create an incompatible mixed context.
+        wildcard = self.acl([self.rule()])
+        self.rpc("acl_interface_set_acl_list", sw_if_index=self.pgs[0],
+                 n_input=2, count=2, acls=[reflect, wildcard])
+        reply = self.api.acl_add_replace(acl_index=wildcard, count=1,
+                                         r=[self.rule(100, 0xfff)])
+        self.assertLess(reply.retval, 0)
+        self.assertEqual(self.api.acl_dump(acl_index=wildcard)[0].r[0].outer_vlan_id_mask, 0)
+        details = self.api.acl_dump(acl_index=vlan)[0].r[0]
+        self.assertEqual((details.outer_vlan_id, details.outer_vlan_id_mask), (100, 0xfff))
+        for value, mask in ((4096, 0xfff), (100, 4096)):
+            reply = self.api.acl_add_replace(acl_index=vlan, count=1,
+                                             r=[self.rule(value, mask)])
+            self.assertLess(reply.retval, 0)
+
+    def test_old_reflect_session_cannot_bypass_new_vlan_rule(self):
+        self.bridge(self.pgs[:2])
+        acl = self.acl([self.rule(action=2)])
+        self.bind(self.pgs[0], acl)
+        self.transmit(self.packet())
+        sessions = self.cli("show acl-plugin sessions")
+        self.assertRegex(sessions, r"Sessions total: add\s+1 - del\s+0 =\s+1")
+        self.assertRegex(sessions, r"Sessions active: add\s+1 - deact\s+0 =\s+1")
+        self.acl([self.rule(100, 0xfff, action=0), self.rule()], index=acl)
+        self.transmit(self.packet(), expect=0)
+        self.assertEqual(self.counter(acl, 0), 1)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
