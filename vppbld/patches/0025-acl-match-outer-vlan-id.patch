diff --git a/src/plugins/acl/outer_vlan.h b/src/plugins/acl/outer_vlan.h
new file mode 100644
index 0000000000000000000000000000000000000000..f32faef1d04c21eba8341d3d2e0b80b4b58f5efc
--- /dev/null
+++ b/src/plugins/acl/outer_vlan.h
@@ -0,0 +1,132 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#ifndef included_acl_outer_vlan_h
+#define included_acl_outer_vlan_h
+
+#include <vnet/l2/l2_input.h>
+#include <vnet/l2/l2_output.h>
+
+/* IN_PORTS needs only interface identity, not VLAN/tag reconstruction. */
+static_always_inline int
+acl_is_bridged_subif (u32 sw_if_index)
+{
+  vnet_main_t *vnm = vnet_get_main ();
+  if (!vnet_sw_interface_is_valid (vnm, sw_if_index) ||
+      vnet_get_sw_interface (vnm, sw_if_index)->type != VNET_SW_INTERFACE_TYPE_SUB ||
+      sw_if_index >= vec_len (l2input_main.configs))
+    return 0;
+  return (l2input_main.configs[sw_if_index].flags &
+          (L2_INPUT_FLAG_BRIDGE | L2_INPUT_FLAG_BVI)) != 0;
+}
+
+/* A bridge/subinterface's classification is retained across tag rewrites.
+ * In particular, after POP_1 a QinQ packet still carries its inner tag; that
+ * tag must not replace the outer VLAN that selected the bridge member. */
+static_always_inline int
+acl_interface_outer_vlan (u32 sw_if_index, int is_input, u16 *vlan_id)
+{
+  vnet_main_t *vnm = vnet_get_main ();
+  if (!vnet_sw_interface_is_valid (vnm, sw_if_index))
+    return 0;
+
+  vnet_sw_interface_t *si = vnet_get_sw_interface (vnm, sw_if_index);
+  l2_input_config_t *l2 =
+    sw_if_index < vec_len (l2input_main.configs) ? &l2input_main.configs[sw_if_index] : 0;
+  int is_bridge = l2 && (l2->flags & (L2_INPUT_FLAG_BRIDGE | L2_INPUT_FLAG_BVI));
+
+  if (si->type == VNET_SW_INTERFACE_TYPE_SUB &&
+      (si->sub.eth.flags.one_tag || si->sub.eth.flags.two_tags) &&
+      !si->sub.eth.flags.outer_vlan_id_any)
+    {
+      *vlan_id = si->sub.eth.outer_vlan_id;
+      return 1;
+    }
+
+  if (sw_if_index < vec_len (l2output_main.configs))
+    {
+      l2_output_config_t *out = &l2output_main.configs[sw_if_index];
+      vtr_config_t *vtr = is_input ? &out->input_vtr : &out->output_vtr;
+      if (vtr->push_bytes)
+	{
+	  *vlan_id =
+	    clib_net_to_host_u16 (vtr->tags[vtr->push_bytes == 4 ? 1 : 0].priority_cfi_and_id) &
+	    0xfff;
+	  return 1;
+	}
+    }
+
+  /* SONiC assigns bd_id = VLAN ID, providing the PVID for untagged
+   * members without an artificial tag rewrite on the host interface. */
+  if (is_bridge && l2->bd_index < vec_len (l2input_main.bd_configs))
+    {
+      u32 bd_id = l2input_main.bd_configs[l2->bd_index].bd_id;
+      if (bd_id > 0 && bd_id < 4095)
+	{
+	  *vlan_id = bd_id;
+	  return 1;
+	}
+    }
+  return 0;
+}
+
+static_always_inline void
+acl_fill_outer_vlan (vlib_buffer_t *b, int is_input, int is_l2_path, fa_5tuple_t *tuple)
+{
+  u16 vlan_id = 0;
+  u32 sw_if_index = vnet_buffer (b)->sw_if_index[is_input ? VLIB_RX : VLIB_TX];
+  int valid = acl_interface_outer_vlan (sw_if_index, is_input, &vlan_id);
+
+  if (!valid)
+    {
+      /* L3 ingress may already have consumed the Ethernet header. L3
+       * output has a fresh rewrite at current_data; its ingress offset
+       * must never be mistaken for the egress Ethernet header. */
+      int l2_offset = b->current_data;
+      int has_l2 = is_l2_path;
+      if (!is_l2_path && is_input && (b->flags & VNET_BUFFER_F_L2_HDR_OFFSET_VALID))
+	{
+	  l2_offset = vnet_buffer (b)->l2_hdr_offset;
+	  has_l2 = 1;
+	}
+      else if (!is_l2_path && !is_input)
+	has_l2 = vnet_buffer (b)->ip.save_rewrite_length >= sizeof (ethernet_header_t);
+
+      if (has_l2 && l2_offset >= -VLIB_BUFFER_PRE_DATA_SIZE &&
+	  l2_offset + sizeof (ethernet_header_t) + sizeof (ethernet_vlan_header_t) <=
+	    b->current_data + b->current_length)
+	{
+	  ethernet_header_t *eth = (void *) (b->data + l2_offset);
+	  if (ethernet_frame_is_tagged (clib_net_to_host_u16 (eth->type)))
+	    {
+	      ethernet_vlan_header_t *tag = (void *) (eth + 1);
+	      vlan_id = clib_net_to_host_u16 (tag->priority_cfi_and_id) & 0xfff;
+	      valid = 1;
+	    }
+	}
+    }
+  tuple->pkt.outer_vlan_id = vlan_id;
+  tuple->pkt.outer_vlan_valid = valid;
+}
+
+static_always_inline int
+acl_match_outer_vlan (acl_rule_t *r, fa_5tuple_t *tuple)
+{
+  return !r->outer_vlan_id_mask ||
+	 (tuple->pkt.outer_vlan_valid &&
+	  ((tuple->pkt.outer_vlan_id ^ r->outer_vlan_id) & r->outer_vlan_id_mask) == 0);
+}
+
+static_always_inline int
+acl_match_in_interface (acl_rule_t *r, fa_5tuple_t *tuple)
+{
+  if (!r->in_sw_if_index || tuple->l4.lsb_of_sw_if_index == r->in_sw_if_index)
+    return 1;
+  if (tuple->pkt.is_bridged_subif &&
+      vnet_sw_interface_is_valid (vnet_get_main (), tuple->l4.lsb_of_sw_if_index))
+    {
+      vnet_sw_interface_t *si =
+	vnet_get_sup_sw_interface (vnet_get_main (), tuple->l4.lsb_of_sw_if_index);
+      return si->sw_if_index == r->in_sw_if_index;
+    }
+  return 0;
+}
+#endif
