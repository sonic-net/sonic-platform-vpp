index 0000000000000000000000000000000000000000..44c57fe5c8af1783e15c035c716a86a9b75fc089
--- /dev/null
+++ b/test/test_acl_outer_vlan.py
@@ -0,0 +1,433 @@
+#!/usr/bin/env python3
+"""VLAN qualifiers, inherited ingress-port scope, and ACL lookup selection."""
+
+import os
+import re
+import unittest
+
+from scapy.layers.inet import IP, UDP
+from scapy.layers.inet6 import IPv6, IPv6ExtHdrFragment
+from scapy.layers.l2 import Dot1Q, Dot1AD, Ether
+from scapy.packet import Raw
+
+from asfframework import VppTestRunner
+from config import config
+from framework import VppTestCase
+
+
+@unittest.skipIf("acl" in config.excluded_plugins, "Exclude ACL plugin tests")
+class TestAclOuterVlan(VppTestCase):
+    """VLAN-aware ACLs and qualifier-dependent hash/linear lookup."""
+
+    vpp_worker_count = 0
+    extra_vpp_plugin_config = ["plugin acl_plugin.so { enable }"]
+
+    @classmethod
+    def setUpClass(cls):
+        # run_tests.py supplies cores; also support direct VppTestRunner use.
+        if not cls.cpus:
+            cls.assign_cores([[min(os.sched_getaffinity(0))]])
+        super().setUpClass()
+
+    def setUp(self):
+        super().setUp()
+        self.api = self.vapi.papi
+        self.stats = self.statistics
+        self.bridge_domains = set()
+        self.bridged_interfaces = set()
+        self.bound_interfaces = set()
+        self.acls = set()
+        self.subinterfaces = []
+        self.addresses = []
+        self.neighbors = []
+        self.created_pg_interfaces = []
+        self.cleaning = False
+        self.cleaned = False
+        # Cleanup also runs when a test assertion or subsequent setup fails.
+        self.addCleanup(self.cleanup_config)
+        self.create_pg_interfaces(range(3))
+        self.created_pg_interfaces = list(self.pg_interfaces)
+        self.pgs = [interface.sw_if_index for interface in self.pg_interfaces]
+        for i, interface in enumerate(self.pg_interfaces):
+            interface.admin_up()
+            self.rpc("sw_interface_set_mac_address",
+                     sw_if_index=interface.sw_if_index,
+                     mac_address=f"02:00:00:00:00:{i + 1:02x}")
+        self.cli("set acl-plugin use-hash-acl-matching 1")
+        self.rpc("acl_stats_intf_counters_enable", enable=1)
+
+    def tearDown(self):
+        # Leave the framework's diagnostics in place before removing raw API
+        # objects. unittest then runs cleanup_config before the next method.
+        super().tearDown()
+
+    def rpc(self, name, **kwargs):
+        reply = getattr(self.api, name)(**kwargs)
+        self.assertEqual(reply.retval, 0, (name, kwargs, reply))
+        if self.cleaning:
+            return reply
+        if name == "acl_add_replace":
+            self.acls.add(reply.acl_index)
+        elif name == "acl_interface_set_acl_list":
+            self.bound_interfaces.add(kwargs["sw_if_index"])
+        elif name in ("create_subif", "create_vlan_subif"):
+            self.subinterfaces.append(reply.sw_if_index)
+        elif name == "bridge_domain_add_del_v2" and kwargs.get("is_add", 1):
+            self.bridge_domains.add(kwargs["bd_id"])
+        elif name == "sw_interface_set_l2_bridge":
+            if kwargs.get("enable", 1):
+                self.bridged_interfaces.add(kwargs["rx_sw_if_index"])
+            else:
+                self.bridged_interfaces.discard(kwargs["rx_sw_if_index"])
+        elif name == "sw_interface_add_del_address" and kwargs.get("is_add", 1):
+            self.addresses.append((kwargs["sw_if_index"], kwargs["prefix"]))
+        elif name == "ip_neighbor_add_del" and kwargs.get("is_add", 1):
+            self.neighbors.append(dict(kwargs["neighbor"]))
+        return reply
+
+    def cli(self, command):
+        return self.vapi.cli(command)
+
+    def cleanup_config(self):
+        if self.cleaned or self.vpp_dead:
+            return
+        self.cleaning = True
+        errors = []
+
+        def remove(name, **kwargs):
+            try:
+                self.rpc(name, **kwargs)
+            except Exception as error:
+                errors.append(f"{name} {kwargs}: {error}")
+
+        # One cleanup pass uses current objects, not historical VLAN moves:
+        # detach policies before deleting ACLs, detach members before BDs,
+        # and delete all children before their packet-generator parents.
+        for interface in sorted(self.bound_interfaces):
+            remove("acl_interface_set_acl_list", sw_if_index=interface,
+                   n_input=0, count=0, acls=[])
+        for acl in sorted(self.acls, reverse=True):
+            remove("acl_del", acl_index=acl)
+        for neighbor in reversed(self.neighbors):
+            remove("ip_neighbor_add_del", is_add=0, neighbor=neighbor)
+        for interface, prefix in reversed(self.addresses):
+            remove("sw_interface_add_del_address", sw_if_index=interface,
+                   is_add=0, prefix=prefix)
+        for interface in sorted(self.bridged_interfaces):
+            remove("sw_interface_set_l2_bridge", rx_sw_if_index=interface,
+                   bd_id=0, enable=0)
+        for interface in reversed(self.subinterfaces):
+            remove("sw_interface_set_flags", sw_if_index=interface, flags=0)
+            remove("delete_subif", sw_if_index=interface)
+        for vlan in sorted(self.bridge_domains, reverse=True):
+            remove("bridge_domain_add_del_v2", bd_id=vlan, is_add=0)
+        for interface in reversed(self.created_pg_interfaces):
+            try:
+                interface.admin_down()
+                interface.remove_vpp_config()
+            except Exception as error:
+                errors.append(f"remove {interface.name}: {error}")
+        remove("acl_stats_intf_counters_enable", enable=0)
+        self.cleaned = True
+        self.assertEqual(errors, [], "VPP configuration cleanup failed")
+
+    def bridge(self, interfaces, vlan=100):
+        if vlan not in self.bridge_domains:
+            self.rpc("bridge_domain_add_del_v2", bd_id=vlan, is_add=1,
+                     flood=1, uu_flood=1, learn=0, forward=1)
+            self.bridge_domains.add(vlan)
+        for interface in interfaces:
+            self.rpc("sw_interface_set_l2_bridge", rx_sw_if_index=interface,
+                     bd_id=vlan, enable=1)
+
+    def child(self, parent, vlan=100, dot1ad=False):
+        # A single outer tag classification without exact-match also accepts
+        # QinQ. POP_1 must leave the inner customer tag intact.
+        child = self.rpc("create_subif", sw_if_index=parent, sub_id=vlan,
+                         outer_vlan_id=vlan, sub_if_flags=2 | (8 if dot1ad else 0))
+        self.rpc("sw_interface_set_flags", sw_if_index=child.sw_if_index, flags=1)
+        self.rpc("l2_interface_vlan_tag_rewrite", sw_if_index=child.sw_if_index,
+                 vtr_op=3, push_dot1q=not dot1ad)
+        return child.sw_if_index
+
+    def rule(self, vlan=0, mask=0, action=1, ipv6=False, in_port=0):
+        return dict(is_permit=action, src_prefix="::/0" if ipv6 else "0.0.0.0/0",
+                    dst_prefix="::/0" if ipv6 else "0.0.0.0/0", proto=0,
+                    srcport_or_icmptype_last=65535, dstport_or_icmpcode_last=65535,
+                    outer_vlan_id=vlan, outer_vlan_id_mask=mask,
+                    in_sw_if_index=in_port)
+
+    def acl(self, rules, index=0xffffffff):
+        return self.rpc("acl_add_replace", acl_index=index, count=len(rules),
+                        r=rules, tag="outer-vlan-regression").acl_index
+
+    def bind(self, interface, acl, ingress=True):
+        self.rpc("acl_interface_set_acl_list", sw_if_index=interface,
+                 n_input=int(ingress), count=1, acls=[acl])
+
+    def packet(self, ipv6=False, tags=(), dot1ad=False, fragment=False,
+               routed=False):
+        packet = Ether(src="02:00:00:00:10:01",
+                       dst="02:00:00:00:00:01" if routed else "02:00:00:00:10:02")
+        for i, vlan in enumerate(tags):
+            packet /= Dot1AD(vlan=vlan) if dot1ad and i == 0 else Dot1Q(vlan=vlan)
+        packet /= (IPv6(src="2001:db8:1::2", dst="2001:db8:2::2") if ipv6
+                   else IP(src="192.0.2.2", dst="198.51.100.2"))
+        if fragment:
+            if ipv6:
+                packet /= IPv6ExtHdrFragment(nh=17, offset=1, id=1)
+            else:
+                packet[IP].frag = 1
+                packet[IP].proto = 17
+            packet /= Raw(b"fragment payload" * 4)
+        else:
+            packet /= UDP(sport=12345, dport=23456) / Raw(b"ACL VLAN regression" * 3)
+        return packet
+
+    def transmit(self, packet, expect=1, dst_pg=1):
+        self.pg0.add_stream([packet])
+        self.pg_enable_capture(self.pg_interfaces)
+        self.pg_start()
+        destination = self.pg_interfaces[dst_pg]
+        if expect:
+            return destination.get_capture(expect, timeout=1)
+        destination.assert_nothing_captured(timeout=0.05)
+        return []
+
+    def counter(self, acl, rule):
+        return self.stats[f"/acl/{acl}/matches"][:, rule].sum_packets()
+
+    def test_hash_collisions_masks_wildcard_and_fragments(self):
+        """VLAN collisions, wildcard/masked matches, and fragment fallback."""
+        self.bridge(self.pgs[:2])
+        for ipv6 in (False, True):
+            rules = [self.rule(200, 0xfff, ipv6=ipv6),
+                     self.rule(100, 0xfff, action=0, ipv6=ipv6),
+                     self.rule(ipv6=ipv6)]
+            acl = self.acl(rules)
+            self.bind(self.pgs[0], acl)
+            for hashed in (1, 0):
+                self.cli(f"set acl-plugin use-hash-acl-matching {hashed}")
+                self.transmit(self.packet(ipv6), expect=0)
+                # Nonfirst fragments take the linear fallback in hash mode.
+                self.transmit(self.packet(ipv6, fragment=True), expect=0)
+            self.assertEqual(self.counter(acl, 1), 4)
+            # All IP/L4 fields remain identical, only membership/PVID changes.
+            self.bridge(self.pgs[:2], vlan=200)
+            self.cli("set acl-plugin use-hash-acl-matching 1")
+            self.transmit(self.packet(ipv6))
+            self.assertEqual(self.counter(acl, 0), 1)
+            self.bridge(self.pgs[:2], vlan=300)
+            self.transmit(self.packet(ipv6))
+            self.assertEqual(self.counter(acl, 2), 1)
+            # Partial masks retain only the specified VID bits.
+            acl = self.acl([self.rule(0x120, 0xff0, ipv6=ipv6),
+                            self.rule(action=0, ipv6=ipv6)], index=acl)
+            self.bridge(self.pgs[:2], vlan=0x12f)
+            self.transmit(self.packet(ipv6))
+            self.bridge(self.pgs[:2], vlan=0x130)
+            self.transmit(self.packet(ipv6), expect=0)
+            self.assertEqual(self.counter(acl, 0), 1)
+            self.assertEqual(self.counter(acl, 1), 1)
+            self.bridge(self.pgs[:2])
+
+    def test_qinq_ingress_parent_and_exact_child_scope(self):
+        """QinQ ingress preserves service VID and parent/exact-child scope."""
+        child = self.child(self.pgs[0])
+        self.bridge([child, self.pgs[1]])
+        for ipv6 in (False, True):
+            for in_port in (self.pgs[0], child):
+                acl = self.acl([self.rule(100, 0xfff, ipv6=ipv6, in_port=in_port),
+                                self.rule(action=0, ipv6=ipv6)])
+                self.bind(child, acl)
+                captured = self.transmit(self.packet(ipv6, tags=(100, 10)))
+                self.assertEqual(captured[0][Dot1Q].vlan, 10)
+                self.assertEqual(self.counter(acl, 0), 1)
+        # A different physical parent must still fail its scoped rule.
+        acl = self.acl([self.rule(100, 0xfff, in_port=self.pgs[2]),
+                        self.rule(action=0)])
+        self.bind(child, acl)
+        self.transmit(self.packet(tags=(100, 10)), expect=0)
+        self.assertEqual(self.counter(acl, 1), 1)
+
+    def test_qinq_egress_untagged_pvid_and_tagged_member(self):
+        """QinQ egress uses native PVID or the output child service VID."""
+        ingress = self.child(self.pgs[0])
+        self.bridge([ingress, self.pgs[1]])
+        for ipv6 in (False, True):
+            acl = self.acl([self.rule(10, 0xfff, action=0, ipv6=ipv6),
+                            self.rule(100, 0xfff, ipv6=ipv6),
+                            self.rule(action=0, ipv6=ipv6)])
+            self.bind(self.pgs[1], acl, ingress=False)
+            captured = self.transmit(self.packet(ipv6, tags=(100, 10)))
+            self.assertEqual(captured[0][Dot1Q].vlan, 10)
+            self.assertEqual(self.counter(acl, 1), 1)
+        # Output POP_1 is reversed to PUSH_1. The VLAN to be put on the
+        # wire, rather than the surviving inner tag, must select the rule.
+        self.rpc("sw_interface_set_l2_bridge", rx_sw_if_index=self.pgs[1],
+                 bd_id=100, enable=0)
+        egress = self.child(self.pgs[1], vlan=200, dot1ad=True)
+        self.bridge([ingress, egress])
+        for ipv6 in (False, True):
+            acl = self.acl([self.rule(100, 0xfff, action=0, ipv6=ipv6),
+                            self.rule(200, 0xfff, ipv6=ipv6),
+                            self.rule(action=0, ipv6=ipv6)])
+            self.bind(egress, acl, ingress=False)
+            captured = self.transmit(self.packet(ipv6, tags=(100, 10)))
+            self.assertEqual(captured[0][Dot1AD].vlan, 200)
+            self.assertEqual(captured[0][Dot1Q].vlan, 10)
+            self.assertEqual(self.counter(acl, 1), 1)
+
+    def test_routed_subinterface_vlan_metadata(self):
+        """Routed VLAN ingress and egress use different interface VLANs."""
+        ingress = self.rpc("create_vlan_subif", sw_if_index=self.pgs[0],
+                           vlan_id=100).sw_if_index
+        egress = self.rpc("create_vlan_subif", sw_if_index=self.pgs[1],
+                          vlan_id=200).sw_if_index
+        for interface in (ingress, egress):
+            self.rpc("sw_interface_set_flags", sw_if_index=interface, flags=1)
+        for ipv6 in (False, True):
+            for interface, prefix in ((ingress, "2001:db8:1::1/64" if ipv6 else "192.0.2.1/24"),
+                                      (egress, "2001:db8:2::1/64" if ipv6 else "198.51.100.1/24")):
+                self.rpc("sw_interface_add_del_address", sw_if_index=interface,
+                         is_add=1, prefix=prefix)
+            self.rpc("ip_neighbor_add_del", is_add=1,
+                     neighbor=dict(sw_if_index=egress, flags=1,
+                                   ip_address="2001:db8:2::2" if ipv6 else "198.51.100.2",
+                                   mac_address="02:00:00:00:10:02"))
+            acl_in = self.acl([self.rule(100, 0xfff, ipv6=ipv6),
+                               self.rule(action=0, ipv6=ipv6)])
