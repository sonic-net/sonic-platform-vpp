+    def test_old_reflect_session_cannot_bypass_new_vlan_rule(self):
+        """A cached session cannot bypass a subsequently added VLAN rule."""
+        self.bridge(self.pgs[:2])
+        acl = self.acl([self.rule(action=2)])
+        self.bind(self.pgs[0], acl)
+        self.transmit(self.packet())
+        sessions = self.cli("show acl-plugin sessions")
+        self.assertRegex(sessions, r"Sessions total: add\s+1 - del\s+0 =\s+1")
+        self.assertRegex(sessions, r"Sessions active: add\s+1 - deact\s+0 =\s+1")
+        self.acl([self.rule(100, 0xfff, action=0), self.rule()], index=acl)
+        self.transmit(self.packet(), expect=0)
+        self.assertEqual(self.counter(acl, 0), 1)
