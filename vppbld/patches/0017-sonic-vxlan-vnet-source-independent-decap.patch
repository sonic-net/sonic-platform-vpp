 l2_to_bvi_dmac_check (vnet_hw_interface_t * hi, u8 * dmac,
 		      ethernet_interface_t * ei, u8 have_sec_dmac)
@@ -69,7 +72,12 @@ l2_to_bvi (vlib_main_t * vlib_main,
 				   0 /* have_sec_dmac */ );
 
       if (rv != TO_BVI_ERR_OK)
-	return rv;
