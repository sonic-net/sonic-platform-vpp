From: SONiC-VPP <sonic-vpp@sonic.net>
Subject: [PATCH] ip4/ip6-local: exempt tunnel decap from the local-source checks

A VTEP / tunnel endpoint decapsulates outer packets source-independently
(RFC 7348 for VXLAN; equivalently for IP-in-IP subnet decap): the outer
source IP of a decap packet is arbitrary and may be unroutable or coincide
with one of the switch's own local addresses. VPP's ip4-local node applies
two source checks to every locally-terminated packet before it is handed to
the per-protocol local next node:

  - IP4_ERROR_SPOOFED_LOCAL_PACKETS, if the source resolves to a local
    (DPO_RECEIVE) address; and
  - IP4_ERROR_SRC_LOOKUP_MISS, if there is no uRPF route back to the source.

Either check drops legitimate decap traffic to a local VTEP before it can
reach vxlan4-input / ipip4-input, so decap silently fails. This is observed
on SONiC-VPP as outer-IPv4 VXLAN and IP-in-IP decap failing (the ttl VXLAN
test hits SRC_LOOKUP_MISS with an unroutable outer source; the VNET IP-in-IP
test hits SPOOFED_LOCAL_PACKETS with an outer source that is a local DUT
address), while the IPv6-underlay cases pass only because their outer
sources happen to be routable and non-local. Hardware ASICs decap
source-independently and apply no such check.

Exempt tunnel-decap candidates (UDP to the VXLAN dst port 4789, and IP-in-IP
protocols 4 / 41) from BOTH ip4-local source checks. The decap node still
gates real decap on the tunnel lookup, so a non-tunnel packet to a local
address is still dropped there; anti-spoofing / uRPF is unchanged for every
other protocol.

The same exemption is applied to ip6-local for the IPv6 underlay.
ip6-local has only the uRPF source check (IP6_ERROR_SRC_LOOKUP_MISS,
gated on the "unroutable host" test and skipped for ICMP/link-local),
so VXLAN-over-IPv6 and IP-in-IPv6 decap are exempted there in the same
way; there is no ip6-local spoofed-local check to adjust.
---
diff --git a/src/vnet/ip/ip4_forward.c b/src/vnet/ip/ip4_forward.c
index da99989c3..74a495c0d 100644
--- a/src/vnet/ip/ip4_forward.c
+++ b/src/vnet/ip/ip4_forward.c
@@ -1475,6 +1475,34 @@ typedef struct
   u8 first;
+  u8 tunnel_decap;
 } ip4_local_last_check_t;
 
+/*
+ * SONiC: a VTEP / tunnel endpoint decapsulates outer packets source-
+ * independently (RFC 7348 for VXLAN; likewise for IP-in-IP subnet decap):
+ * the outer source IP is arbitrary and may be unroutable or coincide with
+ * one of the switch's own local addresses. ip4-local's source checks would
+ * otherwise drop such a packet - as a spoofed local-address packet
+ * (IP4_ERROR_SPOOFED_LOCAL_PACKETS) or as one from an unroutable host
+ * (IP4_ERROR_SRC_LOOKUP_MISS) - before it can reach the decap node
+ * (vxlan4-input / ipip4-input). Exempt tunnel-decap candidates from both
+ * source checks; the decap node still gates real decap on the tunnel
+ * lookup, and anti-spoofing is unchanged for all other traffic.
+ */
+always_inline int
+ip4_local_is_tunnel_decap (const ip4_header_t *ip0)
+{
+  /* VXLAN: UDP to the IANA VXLAN dst port (4789, RFC 7348). */
+  if (ip0->protocol == IP_PROTOCOL_UDP)
+    {
+      udp_header_t *udp = (udp_header_t *) ip4_next_header ((ip4_header_t *) ip0);
+      return (udp->dst_port == clib_host_to_net_u16 (4789));
+    }
+  /* IP-in-IP subnet decap: IPv4-in-IP (4) and IPv6-in-IP (41). */
+  if (ip0->protocol == IP_PROTOCOL_IP_IN_IP || ip0->protocol == IP_PROTOCOL_IPV6)
+    return 1;
+  return 0;
+}
+
 always_inline void
 ip4_local_check_src (vlib_buffer_t *b, ip4_header_t *ip0, ip4_local_last_check_t *last_check,
 		     u8 *error0, int is_receive_dpo)
@@ -1481,7 +1509,9 @@ ip4_local_check_src (vlib_buffer_t *b, ip4_header_t *ip0, ip4_local_last_check_t
 {
   const dpo_id_t *dpo0;
   load_balance_t *lb0;
   u32 lbi0;
+  u8 tunnel_decap =
+    *error0 == IP4_ERROR_UNKNOWN_PROTOCOL && ip4_local_is_tunnel_decap (ip0);
 
   vnet_buffer (b)->ip.fib_index =
     vnet_buffer (b)->sw_if_index[VLIB_TX] != ~0 ?
@@ -1503,7 +1534,8 @@ ip4_local_check_src (vlib_buffer_t *b, ip4_header_t *ip0, ip4_local_last_check_t
    *  adjacency for the source address (the remote sender's address)
    */
   if (PREDICT_TRUE ((last_check->src.as_u32 != ip0->src_address.as_u32)) ||
       (last_check->fib_index != vnet_buffer (b)->ip.fib_index) ||
+      (last_check->tunnel_decap != tunnel_decap) ||
       last_check->first)
     {
       lbi0 = ip4_fib_forwarding_lookup (vnet_buffer (b)->ip.fib_index,
@@ -1531,15 +1563,18 @@ ip4_local_check_src (vlib_buffer_t *b, ip4_header_t *ip0, ip4_local_last_check_t
        */
 
       *error0 = ((*error0 == IP4_ERROR_UNKNOWN_PROTOCOL
-		  && dpo0->dpoi_type == DPO_RECEIVE) ?
+		  && dpo0->dpoi_type == DPO_RECEIVE
+		  && !tunnel_decap) ?
 		 IP4_ERROR_SPOOFED_LOCAL_PACKETS : *error0);
       *error0 = ((*error0 == IP4_ERROR_UNKNOWN_PROTOCOL
 		  && !fib_urpf_check_size (lb0->lb_urpf)
-		  && ip0->dst_address.as_u32 != 0xFFFFFFFF) ?
+		  && ip0->dst_address.as_u32 != 0xFFFFFFFF
+		  && !tunnel_decap) ?
 		 IP4_ERROR_SRC_LOOKUP_MISS : *error0);
 
       last_check->src.as_u32 = ip0->src_address.as_u32;
       last_check->lbi = lbi0;
       last_check->error = *error0;
       last_check->fib_index = vnet_buffer (b)->ip.fib_index;
+      last_check->tunnel_decap = tunnel_decap;
     }
@@ -1559,10 +1594,18 @@ ip4_local_check_src_x2 (vlib_buffer_t **b, ip4_header_t **ip, ip4_local_last_che
 {
   const dpo_id_t *dpo[2];
   load_balance_t *lb[2];
   u32 not_last_hit;
   u32 lbi[2];
+  u8 tunnel_decap[2];
+
+  tunnel_decap[0] = error[0] == IP4_ERROR_UNKNOWN_PROTOCOL &&
+    ip4_local_is_tunnel_decap (ip[0]);
+  tunnel_decap[1] = error[1] == IP4_ERROR_UNKNOWN_PROTOCOL &&
+    ip4_local_is_tunnel_decap (ip[1]);
 
   not_last_hit = last_check->first;
   not_last_hit |= ip[0]->src_address.as_u32 ^ last_check->src.as_u32;
   not_last_hit |= ip[1]->src_address.as_u32 ^ last_check->src.as_u32;
+  not_last_hit |= tunnel_decap[0] ^ last_check->tunnel_decap;
+  not_last_hit |= tunnel_decap[1] ^ last_check->tunnel_decap;
 
@@ -1624,23 +1667,28 @@ ip4_local_check_src_x2 (vlib_buffer_t **b, ip4_header_t **ip, ip4_local_last_che
       last_check->first = error[1] == IP4_ERROR_UNKNOWN_PROTOCOL ? 0 : 1;
 
       error[0] = ((error[0] == IP4_ERROR_UNKNOWN_PROTOCOL &&
-		   dpo[0]->dpoi_type == DPO_RECEIVE) ?
+		   dpo[0]->dpoi_type == DPO_RECEIVE &&
+		   !tunnel_decap[0]) ?
 		  IP4_ERROR_SPOOFED_LOCAL_PACKETS : error[0]);
       error[0] = ((error[0] == IP4_ERROR_UNKNOWN_PROTOCOL &&
 		   !fib_urpf_check_size (lb[0]->lb_urpf) &&
-		   ip[0]->dst_address.as_u32 != 0xFFFFFFFF)
+		   ip[0]->dst_address.as_u32 != 0xFFFFFFFF &&
+		   !tunnel_decap[0])
 		  ? IP4_ERROR_SRC_LOOKUP_MISS : error[0]);
 
       error[1] = ((error[1] == IP4_ERROR_UNKNOWN_PROTOCOL &&
-		   dpo[1]->dpoi_type == DPO_RECEIVE) ?
+		   dpo[1]->dpoi_type == DPO_RECEIVE &&
+		   !tunnel_decap[1]) ?
 		  IP4_ERROR_SPOOFED_LOCAL_PACKETS : error[1]);
       error[1] = ((error[1] == IP4_ERROR_UNKNOWN_PROTOCOL &&
 		   !fib_urpf_check_size (lb[1]->lb_urpf) &&
-		   ip[1]->dst_address.as_u32 != 0xFFFFFFFF)
+		   ip[1]->dst_address.as_u32 != 0xFFFFFFFF &&
+		   !tunnel_decap[1])
 		  ? IP4_ERROR_SRC_LOOKUP_MISS : error[1]);
 
       last_check->src.as_u32 = ip[1]->src_address.as_u32;
       last_check->lbi = lbi[1];
       last_check->error = error[1];
       last_check->fib_index = vnet_buffer (b[1])->ip.fib_index;
+      last_check->tunnel_decap = tunnel_decap[1];
     }
diff --git a/src/vnet/ip/ip6_forward.c b/src/vnet/ip/ip6_forward.c
index 944b1d887..931161870 100644
--- a/src/vnet/ip/ip6_forward.c
+++ b/src/vnet/ip/ip6_forward.c
@@ -1233,6 +1233,29 @@ ip6_tcp_udp_icmp_bad_length (vlib_main_t * vm, vlib_buffer_t * p0)
     return 1;
 }
 
+/*
+ * SONiC: IPv6 mirror of ip4_local_is_tunnel_decap. A VTEP / tunnel endpoint
+ * decapsulates outer packets source-independently, so the outer source is
+ * arbitrary; exempt tunnel-decap candidates (VXLAN UDP:4789 and IP-in-IP
+ * proto 4/41) from ip6-local's uRPF source check so they reach the decap
+ * node (vxlan6-input / ipip6-input), which still gates real decap on the
+ * tunnel lookup. uRPF is unchanged for all other traffic.
+ */
+always_inline int
+ip6_local_is_tunnel_decap (const ip6_header_t *ip0)
+{
+  /* VXLAN: UDP to the IANA VXLAN dst port (4789, RFC 7348). */
+  if (ip0->protocol == IP_PROTOCOL_UDP)
+    {
+      udp_header_t *udp = (udp_header_t *) ip6_next_header ((ip6_header_t *) ip0);
+      return (udp->dst_port == clib_host_to_net_u16 (4789));
+    }
+  /* IP-in-IP subnet decap: IPv4-in-IP (4) and IPv6-in-IP (41). */
+  if (ip0->protocol == IP_PROTOCOL_IP_IN_IP || ip0->protocol == IP_PROTOCOL_IPV6)
+    return 1;
+  return 0;
+}
+
 always_inline uword
 ip6_local_inline (vlib_main_t *vm, vlib_node_runtime_t *node,
 		  vlib_frame_t *frame, int head_of_feature_arc,
@@ -1401,10 +1424,12 @@ ip6_local_inline (vlib_main_t *vm, vlib_node_runtime_t *node,
 	  u8 unroutable[2];
 	  unroutable[0] = error[0] == IP6_ERROR_UNKNOWN_PROTOCOL
 	    && type[0] != IP_BUILTIN_PROTOCOL_ICMP
-	    && !ip6_address_is_link_local_unicast (&ip[0]->src_address);
+	    && !ip6_address_is_link_local_unicast (&ip[0]->src_address)
+	    && !ip6_local_is_tunnel_decap (ip[0]);
 	  unroutable[1] = error[1] == IP6_ERROR_UNKNOWN_PROTOCOL
 	    && type[1] != IP_BUILTIN_PROTOCOL_ICMP
-	    && !ip6_address_is_link_local_unicast (&ip[1]->src_address);
+	    && !ip6_address_is_link_local_unicast (&ip[1]->src_address)
+	    && !ip6_local_is_tunnel_decap (ip[1]);
 	  if (PREDICT_FALSE (unroutable[0]))
 	    {
 	      error[0] =
@@ -1562,7 +1587,8 @@ ip6_local_inline (vlib_main_t *vm, vlib_node_runtime_t *node,
 	  /* If this is a neighbor solicitation (ICMP), skip source RPF check */
 	  u8 unroutable = error == IP6_ERROR_UNKNOWN_PROTOCOL
 	    && type != IP_BUILTIN_PROTOCOL_ICMP
-	    && !ip6_address_is_link_local_unicast (&ip->src_address);
+	    && !ip6_address_is_link_local_unicast (&ip->src_address)
+	    && !ip6_local_is_tunnel_decap (ip);
 	  if (PREDICT_FALSE (unroutable))
 	    {
 	      error =
