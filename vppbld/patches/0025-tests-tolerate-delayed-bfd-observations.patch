From 7d3fd629144032a73b36e1072e4f31ecd35c55d6 Mon Sep 17 00:00:00 2001
From: Jerome Tollet <jtollet@cisco.com>
Date: Sun, 30 Aug 2026 00:11:43 +0200
Subject: [PATCH] tests: tolerate delayed BFD observations

Loaded ARM runners can delay packet capture and Python API event
delivery without changing the BFD protocol timing in VPP. Recent CI
failures missed expected packets after one second and observed a valid
session timeout 18 percent later than its nominal value.

Allow two seconds for expected BFD packets and 25 percent upper
tolerance when measuring session expiry from Python. Keep the 10 percent
lower bound so premature protocol timeouts are still detected.

The three tests from the ARM failure passed 10 consecutive runs on an
ARM64 test system.

Type: fix
Change-Id: Id4d28e3f521eab83037545c325087bbedbfd9f63
Signed-off-by: Jerome Tollet <jtollet@cisco.com>
---
 test/test_bfd.py | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/test/test_bfd.py b/test/test_bfd.py
index 4cbfd886b8ae..4c9c46e240d7 100644
--- a/test/test_bfd.py
+++ b/test/test_bfd.py
@@ -997,7 +997,7 @@ def verify_event(test, event, expected_state):
 
 
 def wait_for_bfd_packet(
-    test, timeout=1, pcap_time_min=None, is_tunnel=False, expected_tos=None
+    test, timeout=2, pcap_time_min=None, is_tunnel=False, expected_tos=None
 ):
     """wait for BFD packet and verify its correctness
 
@@ -1379,7 +1379,7 @@ def test_modify_req_min_rx_double(self):
         verify_event(self, e, expected_state=BFDState.down)
         time_to_event = time.time() - time_mark
         self.assert_in_range(
-            time_to_event, 0.9 * timeout, 1.1 * timeout, "session timeout"
+            time_to_event, 0.9 * timeout, 1.25 * timeout, "session timeout"
         )
 
     def test_modify_req_min_rx_halve(self):
@@ -1596,7 +1596,7 @@ def test_echo_looped_back(self):
         counter = 0
         bfd_control_packets_rx = 0
         while counter < echo_packet_count:
-            p = self.pg0.wait_for_packet(1)
+            p = self.pg0.wait_for_packet(2)
             self.logger.debug(ppp("Got packet:", p))
             ether = p[Ether]
             self.assert_equal(self.pg0.remote_mac, ether.dst, "Destination MAC")
