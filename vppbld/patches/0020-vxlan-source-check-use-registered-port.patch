From: SONiC-VPP <sonic-vpp@sonic.net>
Subject: [PATCH] vxlan: exempt configured UDP ports from local source checks

SAI allows the VXLAN destination port to be configured, while the local-source
check exemption currently recognizes only the default port 4789. Mark UDP
ports when the VXLAN plugin registers them and use that marker when identifying
decap candidates. Other UDP services remain subject to normal source checks,
and the VXLAN input node still performs the authoritative tunnel lookup.

Use the IPv6 extension-header walker to locate the payload protocol and reject
malformed or non-first fragments before reading a UDP header.
---
diff --git a/src/plugins/vxlan/vxlan.c b/src/plugins/vxlan/vxlan.c
index 41e1b1750..ab0f0d945 100644
--- a/src/plugins/vxlan/vxlan.c
+++ b/src/plugins/vxlan/vxlan.c
@@ -824,11 +824,15 @@ int vnet_vxlan_add_del_tunnel
     {
       /* register udp ports */
       if (!is_ip6 && !udp_is_valid_dst_port (a->src_port, 1))
-	udp_register_dst_port (vxm->vlib_main, a->src_port,
-			       vxlan4_input_node.index, 1);
+	{
+	  udp_register_dst_port (vxm->vlib_main, a->src_port, vxlan4_input_node.index, 1);
+	  udp_dst_port_set_local_source_check_exempt (a->src_port, 1, 1);
+	}
       if (is_ip6 && !udp_is_valid_dst_port (a->src_port, 0))
-	udp_register_dst_port (vxm->vlib_main, a->src_port,
-			       vxlan6_input_node.index, 0);
+	{
+	  udp_register_dst_port (vxm->vlib_main, a->src_port, vxlan6_input_node.index, 0);
+	  udp_dst_port_set_local_source_check_exempt (a->src_port, 0, 1);
+	}
     }
 
   return 0;
diff --git a/src/vnet/ip/ip4_forward.c b/src/vnet/ip/ip4_forward.c
index 36de38631..60831ef85 100644
--- a/src/vnet/ip/ip4_forward.c
+++ b/src/vnet/ip/ip4_forward.c
@@ -29,6 +29,7 @@
 #include <vnet/interface_output.h>
 #include <vnet/classify/vnet_classify.h>
 #include <vnet/ip/reass/ip4_full_reass.h>
+#include <vnet/udp/udp_local.h>
 
 /** @brief IPv4 lookup node.
     @node ip4-lookup
@@ -1491,11 +1492,12 @@ typedef struct
 always_inline int
 ip4_local_is_tunnel_decap (const ip4_header_t *ip0)
 {
-  /* VXLAN: UDP to the IANA VXLAN dst port (4789, RFC 7348). */
+  /* VXLAN: UDP to a destination port registered by the VXLAN plugin. */
   if (ip0->protocol == IP_PROTOCOL_UDP)
     {
       udp_header_t *udp = (udp_header_t *) ip4_next_header ((ip4_header_t *) ip0);
-      return (udp->dst_port == clib_host_to_net_u16 (4789));
+      return udp_dst_port_is_local_source_check_exempt (clib_net_to_host_u16 (udp->dst_port),
+							1 /* is_ip4 */);
     }
   /* IP-in-IP subnet decap: IPv4-in-IP (4) and IPv6-in-IP (41). */
   if (ip0->protocol == IP_PROTOCOL_IP_IN_IP || ip0->protocol == IP_PROTOCOL_IPV6)
diff --git a/src/vnet/ip/ip6_forward.c b/src/vnet/ip/ip6_forward.c
index 931161870..397dc102e 100644
--- a/src/vnet/ip/ip6_forward.c
+++ b/src/vnet/ip/ip6_forward.c
@@ -27,6 +27,7 @@
 #endif
 #include <vnet/ip/ip6_forward.h>
 #include <vnet/interface_output.h>
+#include <vnet/udp/udp_local.h>
 
 /* Flag used by IOAM code. Classifier sets it pop-hop-by-hop checks it */
 #define OI_DECAP   0x80000000
@@ -1236,22 +1237,26 @@ ip6_tcp_udp_icmp_bad_length (vlib_main_t * vm, vlib_buffer_t * p0)
 /*
  * SONiC: IPv6 mirror of ip4_local_is_tunnel_decap. A VTEP / tunnel endpoint
  * decapsulates outer packets source-independently, so the outer source is
- * arbitrary; exempt tunnel-decap candidates (VXLAN UDP:4789 and IP-in-IP
- * proto 4/41) from ip6-local's uRPF source check so they reach the decap
+ * arbitrary; exempt tunnel-decap candidates (registered VXLAN UDP ports and
+ * IP-in-IP proto 4/41) from ip6-local's uRPF check so they reach the decap
  * node (vxlan6-input / ipip6-input), which still gates real decap on the
  * tunnel lookup. uRPF is unchanged for all other traffic.
  */
 always_inline int
-ip6_local_is_tunnel_decap (const ip6_header_t *ip0)
+ip6_local_is_tunnel_decap (vlib_buffer_t *b, ip6_header_t *ip0)
 {
-  /* VXLAN: UDP to the IANA VXLAN dst port (4789, RFC 7348). */
-  if (ip0->protocol == IP_PROTOCOL_UDP)
+  u32 payload_offset;
+  int protocol = ip6_locate_header (b, ip0, -1, &payload_offset);
+
+  /* VXLAN: UDP to a destination port registered by the VXLAN plugin. */
+  if (protocol == IP_PROTOCOL_UDP)
     {
-      udp_header_t *udp = (udp_header_t *) ip6_next_header ((ip6_header_t *) ip0);
-      return (udp->dst_port == clib_host_to_net_u16 (4789));
+      udp_header_t *udp = (udp_header_t *) ((u8 *) ip0 + payload_offset);
+      return udp_dst_port_is_local_source_check_exempt (clib_net_to_host_u16 (udp->dst_port),
+							0 /* is_ip4 */);
     }
   /* IP-in-IP subnet decap: IPv4-in-IP (4) and IPv6-in-IP (41). */
-  if (ip0->protocol == IP_PROTOCOL_IP_IN_IP || ip0->protocol == IP_PROTOCOL_IPV6)
+  if (protocol == IP_PROTOCOL_IP_IN_IP || protocol == IP_PROTOCOL_IPV6)
     return 1;
   return 0;
 }
@@ -1422,14 +1427,14 @@ ip6_local_inline (vlib_main_t *vm, vlib_node_runtime_t *node,
 	  /* Drop packets from unroutable hosts. */
 	  /* If this is a neighbor solicitation (ICMP), skip source RPF check */
 	  u8 unroutable[2];
-	  unroutable[0] = error[0] == IP6_ERROR_UNKNOWN_PROTOCOL
-	    && type[0] != IP_BUILTIN_PROTOCOL_ICMP
-	    && !ip6_address_is_link_local_unicast (&ip[0]->src_address)
-	    && !ip6_local_is_tunnel_decap (ip[0]);
-	  unroutable[1] = error[1] == IP6_ERROR_UNKNOWN_PROTOCOL
-	    && type[1] != IP_BUILTIN_PROTOCOL_ICMP
-	    && !ip6_address_is_link_local_unicast (&ip[1]->src_address)
-	    && !ip6_local_is_tunnel_decap (ip[1]);
+	  unroutable[0] = error[0] == IP6_ERROR_UNKNOWN_PROTOCOL &&
+			  type[0] != IP_BUILTIN_PROTOCOL_ICMP &&
+			  !ip6_address_is_link_local_unicast (&ip[0]->src_address) &&
+			  !ip6_local_is_tunnel_decap (b[0], ip[0]);
+	  unroutable[1] = error[1] == IP6_ERROR_UNKNOWN_PROTOCOL &&
+			  type[1] != IP_BUILTIN_PROTOCOL_ICMP &&
+			  !ip6_address_is_link_local_unicast (&ip[1]->src_address) &&
+			  !ip6_local_is_tunnel_decap (b[1], ip[1]);
 	  if (PREDICT_FALSE (unroutable[0]))
 	    {
 	      error[0] =
@@ -1585,10 +1590,9 @@ ip6_local_inline (vlib_main_t *vm, vlib_node_runtime_t *node,
 
 	  /* Drop packets from unroutable hosts. */
 	  /* If this is a neighbor solicitation (ICMP), skip source RPF check */
-	  u8 unroutable = error == IP6_ERROR_UNKNOWN_PROTOCOL
-	    && type != IP_BUILTIN_PROTOCOL_ICMP
-	    && !ip6_address_is_link_local_unicast (&ip->src_address)
-	    && !ip6_local_is_tunnel_decap (ip);
+	  u8 unroutable = error == IP6_ERROR_UNKNOWN_PROTOCOL && type != IP_BUILTIN_PROTOCOL_ICMP &&
+			  !ip6_address_is_link_local_unicast (&ip->src_address) &&
+			  !ip6_local_is_tunnel_decap (b[0], ip);
 	  if (PREDICT_FALSE (unroutable))
 	    {
 	      error =
diff --git a/src/vnet/udp/udp.h b/src/vnet/udp/udp.h
index 8b7ffcd7d..676bb1579 100644
--- a/src/vnet/udp/udp.h
+++ b/src/vnet/udp/udp.h
@@ -102,6 +102,9 @@ typedef struct
   /* Next index for this type. */
   u32 next_index;
 
+  /* Skip local-source validation before dispatching tunnel decap traffic. */
+  u8 local_source_check_exempt;
+
   /* Parser for packet generator edits for this protocol */
   unformat_function_t *unformat_pg_edit;
 } udp_dst_port_info_t;
diff --git a/src/vnet/udp/udp_local.c b/src/vnet/udp/udp_local.c
index b56fd17a0..9399e17f4 100644
--- a/src/vnet/udp/udp_local.c
+++ b/src/vnet/udp/udp_local.c
@@ -436,6 +436,7 @@ udp_add_dst_port (udp_main_t * um, udp_dst_port_t dst_port,
   pi->name = dst_port_name;
   pi->dst_port = dst_port;
   pi->next_index = pi->node_index = ~0;
+  pi->local_source_check_exempt = 0;
 
   hash_set (um->dst_port_info_by_dst_port[is_ip4], dst_port, i);
 
@@ -465,6 +466,7 @@ udp_register_dst_port (vlib_main_t * vm,
       ASSERT (pi);
     }
 
+  pi->local_source_check_exempt = 0;
   pi->node_index = node_index;
   pi->next_index = vlib_node_add_next (vm,
 				       is_ip4 ? udp4_local_node.index
@@ -493,6 +495,8 @@ udp_unregister_dst_port (vlib_main_t * vm, udp_dst_port_t dst_port, u8 is_ip4)
   if (!pi)
     return;
 
+  pi->local_source_check_exempt = 0;
+
   /* Kill the mapping. Don't bother killing the pi, it may be back. */
   if (is_ip4)
     n = sparse_vec_validate (um->next_by_dst_port4,
@@ -516,6 +520,23 @@ udp_is_valid_dst_port (udp_dst_port_t dst_port, u8 is_ip4)
 	  vec_elt (next_by_dst_port, index) != UDP_NO_NODE_SET);
 }
 
+void
+udp_dst_port_set_local_source_check_exempt (udp_dst_port_t dst_port, u8 is_ip4, u8 enable)
+{
+  udp_dst_port_info_t *pi = udp_get_dst_port_info (&udp_main, dst_port, is_ip4);
+
+  if (pi)
+    pi->local_source_check_exempt = enable;
+}
+
+u8
+udp_dst_port_is_local_source_check_exempt (udp_dst_port_t dst_port, u8 is_ip4)
+{
+  udp_dst_port_info_t *pi = udp_get_dst_port_info (&udp_main, dst_port, is_ip4);
+
+  return pi && pi->local_source_check_exempt && udp_is_valid_dst_port (dst_port, is_ip4);
+}
+
 void
 udp_punt_unknown (vlib_main_t * vm, u8 is_ip4, u8 is_add)
 {
diff --git a/src/vnet/udp/udp_local.h b/src/vnet/udp/udp_local.h
index 37ef4df23..060339f9d 100644
--- a/src/vnet/udp/udp_local.h
+++ b/src/vnet/udp/udp_local.h
@@ -66,5 +66,7 @@ void udp_register_dst_port (vlib_main_t * vm,
 void udp_unregister_dst_port (vlib_main_t * vm,
 			      udp_dst_port_t dst_port, u8 is_ip4);
 u8 udp_is_valid_dst_port (udp_dst_port_t dst_port, u8 is_ip4);
+void udp_dst_port_set_local_source_check_exempt (udp_dst_port_t dst_port, u8 is_ip4, u8 enable);
+u8 udp_dst_port_is_local_source_check_exempt (udp_dst_port_t dst_port, u8 is_ip4);
 
 #endif /* SRC_VNET_UDP_UDP_LOCAL_H_ */
