diff --git a/test/test_sflow_interface_sampling_rate.py b/test/test_sflow_interface_sampling_rate.py
new file mode 100644
index 0000000..4c79072
--- /dev/null
+++ b/test/test_sflow_interface_sampling_rate.py
@@ -0,0 +1,171 @@
+#!/usr/bin/env python3
+"""sFlow per-interface sampling rate.
+
+The stock plugin keeps a single global sampling rate for every enabled
+interface.  sflow_interface_sampling_rate_set() adds a per-interface
+override: the datapath samples that interface at its own rate, and the
+per-thread sampling state is re-seeded whenever the rate changes.  A rate of
+0 means "no override", i.e. follow the global rate again.
+"""
+
+import re
+import unittest
+from random import randint
+
+from scapy.layers.inet import IP, UDP
+from scapy.layers.l2 import Ether
+from scapy.packet import Raw
+
+from asfframework import VppTestRunner
+from framework import VppTestCase
+
+GLOBAL_N = 10000
+OVERRIDE_N = 77
+NO_OVERRIDE = 0
+SAMPLE_EVERY_PACKET = 1
+
+
+class SFlowInterfaceSamplingRateTestCase(VppTestCase):
+    """sFlow per-interface sampling rate"""
+
+    def setUp(self):
+        super().setUp()
+        self.create_pg_interfaces(range(2))
+        for i in self.pg_interfaces:
+            i.admin_up()
+            i.config_ip4()
+            i.resolve_arp()
+        # A per-interface rate only means something relative to the global
+        # one, so pin the global rate before every test.  Do it before the
+        # interfaces are enabled: enabling is what seeds their samplers.
+        self.vapi.sflow_sampling_rate_set(sampling_N=GLOBAL_N)
+        for i in self.pg_interfaces:
+            self.vapi.sflow_enable_disable(
+                hw_if_index=i.sw_if_index, enable_disable=True
+            )
+
+    def tearDown(self):
+        for i in self.pg_interfaces:
+            self.vapi.sflow_interface_sampling_rate_set(
+                hw_if_index=i.sw_if_index, sampling_N=NO_OVERRIDE
+            )
+            self.vapi.sflow_enable_disable(
+                hw_if_index=i.sw_if_index, enable_disable=False
+            )
+            i.admin_down()
+            i.unconfig()
+            i.set_table_ip4(0)
+            i.set_table_ip6(0)
+        self.vapi.sflow_sampling_rate_set(sampling_N=GLOBAL_N)
+        super().tearDown()
+
+    def effective_rate(self, itf):
+        """The sampling rate "show sflow" reports for one enabled interface."""
+        out = self.vapi.cli("show sflow")
+        match = re.search(
+            r"sflow enable %s\s+sampling-rate (\d+)" % re.escape(itf.name), out
+        )
+        self.assertIsNotNone(
+            match, "no sampling-rate reported for %s in:\n%s" % (itf.name, out)
+        )
+        return int(match.group(1))
+
+    def get_sflow_counter(self, counter):
+        """Read one sflow error counter, 0 if it has not been bumped yet."""
+        for line in self.vapi.cli("sh errors").split("\n"):
+            fields = line.split()
+            if len(fields) > 1 and fields[1] == "sflow" and counter in line:
+                return int(fields[0])
+        return 0
+
+    def create_stream(self, src_if, dst_if, count):
+        packets = []
+        for i in range(count):
+            info = self.create_packet_info(src_if, dst_if)
+            payload = self.info_to_payload(info)
+            p = (
+                Ether(dst=src_if.local_mac, src=src_if.remote_mac)
+                / IP(src=src_if.remote_ip4, dst=dst_if.remote_ip4)
+                / UDP(sport=randint(49152, 65535), dport=5678)
+                / Raw(payload)
+            )
+            info.data = p.copy()
+            packets.append(p)
+        return packets
+
+    def forward_and_count(self, src_if, dst_if, count):
+        """Forward *count* packets and return the (processed, sampled) delta."""
+        ctr_processed = "sflow packets processed"
+        ctr_sampled = "sflow packets sampled"
+        processed = self.get_sflow_counter(ctr_processed)
+        sampled = self.get_sflow_counter(ctr_sampled)
+        src_if.add_stream(self.create_stream(src_if, dst_if, count))
+        self.pg_enable_capture(self.pg_interfaces)
+        self.pg_start()
+        dst_if.get_capture(count, timeout=2)
+        # the worker counters are only folded into the node counters by the
+        # sflow-process-samples process, so give it a moment.
+        self.sleep(1.0)
+        return (
+            self.get_sflow_counter(ctr_processed) - processed,
+            self.get_sflow_counter(ctr_sampled) - sampled,
+        )
+
+    def test_default_follows_the_global_rate(self):
+        """Without an override an interface samples at the global rate"""
+        for i in self.pg_interfaces:
+            self.assert_equal(self.effective_rate(i), GLOBAL_N, "sampling-rate")
+
+    def test_override_is_per_interface(self):
+        """An override on one interface leaves the other one alone"""
+        self.vapi.sflow_interface_sampling_rate_set(
+            hw_if_index=self.pg0.sw_if_index, sampling_N=OVERRIDE_N
+        )
+        self.assert_equal(
+            self.effective_rate(self.pg0), OVERRIDE_N, "pg0 sampling-rate"
+        )
+        self.assert_equal(self.effective_rate(self.pg1), GLOBAL_N, "pg1 sampling-rate")
+
+    def test_override_survives_a_global_rate_change(self):
+        """A global rate change does not clobber an existing override"""
+        self.vapi.sflow_interface_sampling_rate_set(
+            hw_if_index=self.pg0.sw_if_index, sampling_N=OVERRIDE_N
+        )
+        self.vapi.sflow_sampling_rate_set(sampling_N=GLOBAL_N // 2)
+        self.assert_equal(
+            self.effective_rate(self.pg0), OVERRIDE_N, "pg0 sampling-rate"
+        )
+        self.assert_equal(
+            self.effective_rate(self.pg1), GLOBAL_N // 2, "pg1 sampling-rate"
+        )
+
+    def test_zero_restores_the_global_rate(self):
+        """Clearing the override puts the interface back on the global rate"""
+        self.vapi.sflow_interface_sampling_rate_set(
+            hw_if_index=self.pg0.sw_if_index, sampling_N=OVERRIDE_N
+        )
+        self.vapi.sflow_interface_sampling_rate_set(
+            hw_if_index=self.pg0.sw_if_index, sampling_N=NO_OVERRIDE
+        )
+        self.assert_equal(self.effective_rate(self.pg0), GLOBAL_N, "pg0 sampling-rate")
+
+    def test_datapath_honours_the_override(self):
+        """The datapath samples the interface at its own rate"""
+        self.vapi.sflow_interface_sampling_rate_set(
+            hw_if_index=self.pg0.sw_if_index, sampling_N=SAMPLE_EVERY_PACKET
+        )
+        count = 7
+        processed, sampled = self.forward_and_count(self.pg0, self.pg1, count)
+        self.assert_equal(processed, count, "sflow packets processed")
+        self.assert_equal(sampled, count, "sflow packets sampled")
+
+    def test_unknown_interface_is_rejected(self):
+        """A rate for a non-existent interface is refused"""
+        with self.vapi.assert_negative_api_retval():
+            self.vapi.sflow_interface_sampling_rate_set(
