+static inline u32
+sflow_next_random_skip_if (sflow_main_t *smp, sflow_per_interface_data_t *sfif,
+			   sflow_per_if_sampler_t *smpif)
+{
+  u32 effectiveN = sfif->samplingN ? sfif->samplingN : smp->samplingN;
+  if (effectiveN <= 1)
+    return 1;
+  u32 lim = (2 * effectiveN) - 1;
+  return (random_u32 (&smpif->seed) % lim) + 1;
