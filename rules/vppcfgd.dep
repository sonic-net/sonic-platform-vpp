
SPATH       := $($(SONIC_VPPCFGD)_SRC_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) $(PLATFORM_RULES)/vppcfgd.mk $(PLATFORM_RULES)/vppcfgd.dep
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
SMDEP_FILES := $(addprefix $(SPATH)/,$(shell git -C $(SPATH) ls-files))

$(SONIC_VPPCFGD)_CACHE_MODE  := GIT_CONTENT_SHA
$(SONIC_VPPCFGD)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(SONIC_VPPCFGD)_DEP_FILES   := $(DEP_FILES)
$(SONIC_VPPCFGD)_SMDEP_FILES := $(SMDEP_FILES)
$(SONIC_VPPCFGD)_SMDEP_PATHS := $(SPATH)
